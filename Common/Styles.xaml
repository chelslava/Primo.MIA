<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:Primo.MIA">

    <!-- ═══════════════════════════════════════════════════════════════════
         ЕДИНЫЙ СЛОВАРЬ СТИЛЕЙ АКТИВНОСТЕЙ Primo.MIA
         Подключение:
             <ResourceDictionary.MergedDictionaries>
                 <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
             </ResourceDictionary.MergedDictionaries>
         Конвертеры объявлены здесь с каноническими ключами — локальные
         объявления в UserControl.Resources переопределяют их без конфликтов.
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════════════════════════
         КОНВЕРТЕРЫ (канонические экземпляры)
         ═══════════════════════════════════════════════════════════════════ -->

    <common:EnumToVisibilityConverter x:Key="EnumToVisConverter"/>
    <common:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
    <common:MultiEnumToVisibilityConverter x:Key="MultiEnumToVisConverter"/>
    <common:MultiEnumToVisibilityConverter x:Key="MultiEnumToVisibilityConverter"/>
    <common:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <common:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <common:EnumDisplayNameConverter x:Key="EnumDisplayNameConverter"/>

    <!-- ═══════════════════════════════════════════════════════════════════
         ИМЕНОВАННЫЕ КИСТИ (единая палитра)
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Акцент режима в заголовке: «Модуль: Название [Режим]» -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF1565C0"/>

    <!-- Опасное действие: DryRun, необратимые операции -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FFC55A11"/>

    <!-- Основной цвет текста контролов (лейблы, чекбоксы, подсказки-акценты) -->
    <SolidColorBrush x:Key="TextBrush" Color="#FF2C3E50"/>

    <!-- ═══════════════════════════════════════════════════════════════════
         СТИЛИ ЗАГОЛОВКОВ
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Заголовок активности (может содержать Run'ы с привязкой режима).
         TextWrapping=Wrap: длинные режимы переносятся на 2-ю строку
         вместо обрезки в узкой панели Studio -->
    <Style x:Key="ActivityHeader" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Foreground" Value="#FF0E0E0E"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin"     Value="0,2,0,4"/>
    </Style>

    <!-- Подзаголовок секции -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize"   Value="11"/>
        <Setter Property="Foreground" Value="#FF1565C0"/>
        <Setter Property="Margin"     Value="0,8,0,4"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         СТИЛИ ПОЛЕЙ ВВОДА
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Лейбл поля -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#FF2C3E50"/>
        <Setter Property="Margin"     Value="0,6,0,2"/>
    </Style>

    <!-- Стандартное текстовое поле -->
    <Style x:Key="FieldBox" TargetType="TextBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush"     Value="Transparent"/>
        <Setter Property="TextWrapping"    Value="NoWrap"/>
        <Setter Property="Height"          Value="22"/>
        <Setter Property="Margin"          Value="0,2,6,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Текстовое поле с валидацией -->
    <Style x:Key="ValidatingFieldBox"
           TargetType="TextBox"
           BasedOn="{StaticResource FieldBox}">
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush"     Value="#FFFF5252"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Поле пароля (вместо TextBox: символы скрыты).
         Привязка через common:PasswordBoxHelper.BoundPassword. -->
    <Style x:Key="FieldPasswordBox" TargetType="PasswordBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height"          Value="22"/>
        <Setter Property="Margin"          Value="0,2,6,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Стандартный CheckBox: цвет и отступы централизованы здесь.
         Переопределять индивидуально можно только Margin/ToolTip/FontWeight. -->
    <Style x:Key="FieldCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize"        Value="11"/>
        <Setter Property="Margin"          Value="0,2,6,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor"          Value="Hand"/>
    </Style>

    <!-- «Опасный» CheckBox: DryRun, необратимые операции -->
    <Style x:Key="DangerCheckBox"
           TargetType="CheckBox"
           BasedOn="{StaticResource FieldCheckBox}">
        <Setter Property="Foreground"      Value="{StaticResource DangerBrush}"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         СТИЛИ ВЫПАДАЮЩИХ СПИСКОВ
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Стандартный ComboBox -->
    <Style x:Key="FieldComboBox" TargetType="ComboBox">
        <Setter Property="Height"          Value="22"/>
        <Setter Property="Margin"          Value="0,2,6,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         СТИЛИ КНОПОК
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Кнопка обзора файла -->
    <Style x:Key="BrowseButton" TargetType="Button">
        <Setter Property="Width"           Value="26"/>
        <Setter Property="Height"          Value="22"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="Foreground"      Value="#FF2C3E50"/>
        <Setter Property="Background"      Value="#FFE8ECF0"/>
        <Setter Property="BorderBrush"     Value="#FFB0BAC8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="ToolTip"         Value="Выбрать файл..."/>
    </Style>

    <!-- Кнопка с иконкой -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width"           Value="24"/>
        <Setter Property="Height"          Value="24"/>
        <Setter Property="Padding"         Value="2"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderBrush"     Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
    </Style>

    <!-- Текстовая кнопка (не иконка): ширина по содержимому,
         чтобы текст не обрезался как «+ Д…» у узкой BrowseButton -->
    <Style x:Key="TextButton"
           TargetType="Button"
           BasedOn="{StaticResource BrowseButton}">
        <Setter Property="Width"           Value="Auto"/>
        <Setter Property="Padding"         Value="8,2"/>
        <Setter Property="ToolTip"         Value=""/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         ПОДСКАЗКИ
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Мелкая поясняющая подсказка рядом с полем (FontSize 10, серый) -->
    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize"        Value="10"/>
        <Setter Property="Foreground"      Value="#FF808080"/>
        <Setter Property="TextWrapping"    Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"          Value="0,0,6,0"/>
    </Style>

</ResourceDictionary>
