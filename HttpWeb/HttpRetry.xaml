<UserControl x:Class="Primo.MIA.HttpRetry"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="140" Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Иконка -->
        <Image Grid.Column="0"
               Width="32" Height="32"
               Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/http.png"/>

        <!-- Содержимое -->
        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="5,0,5,5">

            <!-- Заголовок -->
            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="HTTP: Запрос с повторами ["/>
                <Run Text="{Binding Prop_Method, Mode=OneWay, Converter={StaticResource EnumDisplayNameConverter}}"/>
                <Run Text="]"/>
            </TextBlock>

            <!-- URL -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="URL: " VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Prop_Url, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                          />
            </Grid>

            <!-- Retry настройки -->
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="Попыток: " FontSize="10" VerticalAlignment="Center" Foreground="#FF0E0E0E"/>
                <TextBox Width="30"
                         Height="16"
                         FontSize="10"
                         VerticalAlignment="Center"
                         Margin="0"
                         Style="{StaticResource ValidatingFieldBox}">
                    <TextBox.Text>
                        <Binding Path="Prop_MaxRetries" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <local:NumericValidationRule/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
                <TextBlock Text=" Задержка: " FontSize="10" VerticalAlignment="Center" Foreground="#FF0E0E0E"/>
                <TextBox Width="50"
                         Height="16"
                         FontSize="10"
                         VerticalAlignment="Center"
                         Margin="0"
                         Style="{StaticResource ValidatingFieldBox}">
                    <TextBox.Text>
                        <Binding Path="Prop_DelayMs" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <local:NumericValidationRule/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
                <TextBlock Text="мс" FontSize="10" VerticalAlignment="Center" Foreground="#FF0E0E0E"/>
            </StackPanel>

            <!-- Стратегия -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Стратегия: " VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{local:EnumValues local:HttpRetryDelayStrategy}" SelectedValue="{Binding Prop_DelayStrategy}" SelectedValuePath="Key" DisplayMemberPath="Display" Grid.Column="1"
                          Style="{StaticResource FieldComboBox}"/>
            </Grid>

        </StackPanel>
    </Grid>
</UserControl>
