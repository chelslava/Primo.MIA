            <TextBlock Text="JSONPath СЌР»РµРјРµРЅС‚РѕРІ:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ItemsPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
