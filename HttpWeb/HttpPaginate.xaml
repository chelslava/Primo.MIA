                <TextBlock Text="JSONPath РєСѓСЂСЃРѕСЂР°:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_CursorPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
