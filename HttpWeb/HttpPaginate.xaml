<UserControl x:Class="Primo.MIA.HttpPaginate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:common="clr-namespace:Primo.MIA"
             mc:Ignorable="d" xmlns:local="clr-namespace:Primo.MIA" d:DesignHeight="340" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/http.png">
            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="HTTP: Пагинация ["/>
                <Run Text="{Binding Prop_Mode, Mode=OneWay, Converter={StaticResource EnumDisplayNameConverter}}" Foreground="{StaticResource AccentBrush}"/>
                <Run Text="]"/>
            </TextBlock>
            <TextBlock Text="Режим:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{common:EnumValues common:HttpPaginationMode}"
                      SelectedValue="{Binding Prop_Mode}"
                      SelectedValuePath="Key"
                      DisplayMemberPath="Display"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="По номеру страницы — {page} в шаблоне;&#xA;По курсору — {cursor} + JSONPath курсора"/>
            <TextBlock Text="Шаблон URL:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_UrlTemplate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="https://api/x?page={page}&amp;size=50&#xA;https://api/x?cursor={cursor}"/>
            <TextBlock Text="JSONPath элементов:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ItemsPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Путь к массиву элементов страницы: $.data.items[*]"/>
            <StackPanel Visibility="{Binding Prop_Mode,
                                    Converter={StaticResource EnumToVisConverter},
                                    ConverterParameter=Cursor}">
                <TextBlock Text="JSONPath курсора:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_CursorPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                         ToolTip="Путь к следующему курсору: $.meta.next_cursor"/>
            </StackPanel>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Старт. страница:" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                <TextBox Grid.Column="1" Text="{Binding Prop_StartPage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                         ToolTip="Для режима «По номеру» (по умолчанию 1)"/>
                <TextBlock Grid.Column="2" Text="Лимит страниц:" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                <TextBox Grid.Column="3" Text="{Binding Prop_MaxPages, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                         ToolTip="Защита от бесконечного цикла (по умолчанию 100)"/>
            </Grid>
            <CheckBox Style="{StaticResource FieldCheckBox}" Margin="0,6,6,2"
                      Content="Стоп на пустой странице"
                      IsChecked="{Binding Prop_StopOnEmptyPage}"
                      ToolTip="Остановиться, когда страница без элементов"/>
            <CheckBox Style="{StaticResource DangerCheckBox}"
                      Content="Игнорировать ошибки SSL"
                      IsChecked="{Binding Prop_IgnoreSslErrors}"
                      ToolTip="Только для тестовых сред!"/>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Элементы (out): " VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                <TextBox Grid.Column="1" Text="{Binding Prop_Items, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            </Grid>
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Страниц (out): " VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                <TextBox Grid.Column="1" Text="{Binding Prop_PageCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            </Grid>
            <Grid Margin="0,2,0,0"
                  Visibility="{Binding Prop_Mode,
                               Converter={StaticResource EnumToVisConverter},
                               ConverterParameter=Cursor}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Курсор (out): " VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                <TextBox Grid.Column="1" Text="{Binding Prop_NextCursor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            </Grid>
    </local:ActivityPanel>
</UserControl>