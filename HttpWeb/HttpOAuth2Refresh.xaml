<UserControl x:Class="Primo.MIA.HttpOAuth2Refresh"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="100" Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Иконка -->
        <Image Grid.Column="0" Width="32" Height="32" Margin="5" VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/http.png"/>

        <!-- Содержимое -->
        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="5,0,5,5">
            <!-- Заголовок -->
            <TextBlock Text="HTTP: OAuth2 обновление токена" Style="{StaticResource ActivityHeader}"/>

            <!-- Token URL -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Token URL:" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding Prop_TokenUrl, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"/>
            </Grid>

            <!-- Client ID -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Client ID:" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding Prop_ClientId, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"/>
            </Grid>

            <!-- Refresh Token -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Refresh:" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding Prop_RefreshToken, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
