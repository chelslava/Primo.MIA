<UserControl x:Class="Primo.MIA.HttpUpload"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="120" Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Иконка -->
        <Image Grid.Column="0"
               Width="32" Height="32"
               Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/http.png"/>

        <!-- Содержимое -->
        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="5,0,5,5">

            <!-- Заголовок -->
            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="HTTP: Загрузить файл"/>
            </TextBlock>

            <!-- URL -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="URL: " VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Prop_Url, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                          />
            </Grid>

            <!-- Путь к файлу -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Файл: " VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Prop_FilePath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                          />
            </Grid>

            <!-- Опции -->
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="Поле: " Style="{StaticResource FieldLabel}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Prop_FieldName, UpdateSourceTrigger=PropertyChanged}"
                         Width="50"
                         VerticalAlignment="Center"
                         Margin="0"
                         Style="{StaticResource FieldBox}"/>
                <TextBlock Text=" | " Style="{StaticResource HintText}"/>
                <TextBlock Text="Таймаут (сек):" Style="{StaticResource FieldLabel}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBox Width="40"
                         VerticalAlignment="Center"
                         Margin="0"
                         Style="{StaticResource ValidatingFieldBox}">
                    <TextBox.Text>
                        <Binding Path="Prop_Timeout" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <local:NumericValidationRule/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
