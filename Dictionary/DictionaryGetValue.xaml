<!--
    DictionaryGetValue.xaml
    Визуальный интерфейс активности "Получение значения из словаря".

    Функции:
      - Получение значения по ключу
      - Поддержка значения по умолчанию
-->
<UserControl x:Class="Primo.MIA.DictionaryGetValue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="80"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/dict.png"/>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Top"
                    Margin="5,0,5,5">

            <TextBlock Style="{StaticResource ActivityHeader}"
                       Text="Словарь: Получить значение"/>

            <TextBlock Text="Словарь:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Dictionary, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Переменная со словарём"/>

            <TextBlock Text="Ключ:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Key, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Ключ для получения значения"/>

            <TextBlock Text="Значение по умолчанию:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Значение, если ключ не найден (опционально)"/>

            <TextBlock Text="Переменная-результат:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Result, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Имя переменной для сохранения полученного значения"/>

        </StackPanel>
    </Grid>
</UserControl>
