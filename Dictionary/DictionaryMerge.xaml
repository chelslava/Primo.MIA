<!--
    DictionaryMerge.xaml
    Визуальный интерфейс активности "Объединение словарей".

    Стратегии:
      - Overwrite: Перезаписывать дубликаты
      - KeepOriginal: Сохранять оригинальные значения
      - Concat: Конкатенировать значения
-->
<UserControl x:Class="Primo.MIA.DictionaryMerge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="80"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/dict.png"/>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Top"
                    Margin="5,0,5,5">

            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="Словарь: Объединить ["/>
                <Run Text="{Binding Strategy, Mode=OneWay, Converter={StaticResource EnumDisplayNameConverter}}" Foreground="{StaticResource AccentBrush}"/>
                <Run Text="]"/>
            </TextBlock>

            <ComboBox ItemsSource="{local:EnumValues local:DictionaryMergeStrategy}" SelectedValue="{Binding Strategy}" SelectedValuePath="Key" DisplayMemberPath="Display" 
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Стратегия объединения: Overwrite, KeepOriginal, Concat"/>

            <TextBlock Text="Первый словарь:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_FirstDictionary, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Первый словарь для объединения"/>

        </StackPanel>
    </Grid>
</UserControl>
