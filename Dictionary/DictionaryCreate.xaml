<!--
    DictionaryCreate.xaml
    Визуальный интерфейс активности "Создание словаря".

    Режимы:
      CreateEmpty      — создать пустой словарь
      FromLists        — создать из двух списков (ключи и значения)
      Clone            — клонировать существующий словарь
      Invert           — инвертировать словарь (ключи ↔ значения)
-->
<UserControl x:Class="Primo.MIA.DictionaryCreate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="80"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="ModeValues"
                                MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:DictionaryCreateMode"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <local:EnumToVisibilityConverter x:Key="EnumToVisConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/dict.png"/>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Top"
                    Margin="5,0,5,5">

            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="Словарь: Создать [" Foreground="#FF0E0E0E"/>
                <Run Text="{Binding Path=Mode, Mode=OneWay}" Foreground="#FF1565C0"/>
                <Run Text="]" Foreground="#FF0E0E0E"/>
            </TextBlock>

            <TextBlock Text="Режим создания:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Source={StaticResource ModeValues}}"
                      SelectedItem="{Binding Mode}"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Выберите режим создания словаря"/>

            <!-- Блок для режима FromLists -->
            <StackPanel Visibility="{Binding Mode,
                                    Converter={StaticResource EnumToVisConverter},
                                    ConverterParameter=FromLists}">
                <TextBlock Text="Список ключей:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_Keys, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="Переменная со списком ключей"/>

                <TextBlock Text="Список значений:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_Values, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="Переменная со списком значений"/>
            </StackPanel>

            <!-- Блок для режима Clone -->
            <StackPanel Visibility="{Binding Mode,
                                    Converter={StaticResource EnumToVisConverter},
                                    ConverterParameter=Clone}">
                <TextBlock Text="Исходный словарь:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_SourceDictionary, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="Переменная со словарём для клонирования"/>
            </StackPanel>

            <!-- Блок для режима Invert -->
            <StackPanel Visibility="{Binding Mode,
                                    Converter={StaticResource EnumToVisConverter},
                                    ConverterParameter=Invert}">
                <TextBlock Text="Исходный словарь:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_SourceDictionary, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="Переменная со словарём для инвертирования (ключи ↔ значения)"/>
            </StackPanel>

            <TextBlock Text="Переменная-результат:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ResultDictionary, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Имя переменной для сохранения созданного словаря"/>

        </StackPanel>
    </Grid>
</UserControl>
