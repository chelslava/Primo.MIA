<!--
    DictionarySetValue.xaml
    Визуальный интерфейс активности "Установка значения в словаре".

    Функции:
      - Установка значения по ключу
      - Добавление новой пары ключ-значение
-->
<UserControl x:Class="Primo.MIA.DictionarySetValue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="80"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/dict.png">

            <TextBlock Style="{StaticResource ActivityHeader}"
                       Text="Словарь: Установить значение"/>

            <TextBlock Text="Словарь:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Dictionary, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Переменная со словарём"/>

            <TextBlock Text="Ключ:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Key, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Ключ для установки значения"/>

            <TextBlock Text="Значение:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Value, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Значение для установки"/>
    </local:ActivityPanel>
</UserControl>
