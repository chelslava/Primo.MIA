<!--
    DictionaryFilter.xaml
    Визуальный интерфейс активности "Фильтрация словаря".

    Режимы:
      ByKey       — фильтрация по ключам
      ByValue     — фильтрация по значениям
      ByPredicate — фильтрация по условию (лямбда)
-->
<UserControl x:Class="Primo.MIA.DictionaryFilter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="80"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="TargetValues"
                                MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:DictionaryFilterTarget"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <local:EnumToVisibilityConverter x:Key="EnumToVisConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/dict.png"/>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Top"
                    Margin="5,0,5,5">

            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="Словарь: Фильтровать [" Foreground="#FF0E0E0E"/>
                <Run Text="{Binding Path=Prop_Target, Mode=OneWay}" Foreground="#FF1565C0"/>
                <Run Text="]" Foreground="#FF0E0E0E"/>
            </TextBlock>

            <TextBlock Text="Режим фильтрации:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Source={StaticResource TargetValues}}"
                      SelectedItem="{Binding Prop_Target}"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Выберите режим фильтрации словаря"/>

            <TextBlock Text="Исходный словарь:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Dictionary, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Переменная со словарём для фильтрации"/>

            <!-- Блок для режима ByKey -->
            <StackPanel Visibility="{Binding Prop_Target,
                                    Converter={StaticResource EnumToVisConverter},
                                    ConverterParameter=ByKey}">
                <TextBlock Text="Шаблон ключа:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_KeyPattern, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="Шаблон для фильтрации ключей (поддерживает * и ?)"/>
            </StackPanel>

            <!-- Блок для режима ByValue -->
            <StackPanel Visibility="{Binding Prop_Target,
                                    Converter={StaticResource EnumToVisConverter},
                                    ConverterParameter=ByValue}">
                <TextBlock Text="Шаблон значения:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_ValuePattern, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="Шаблон для фильтрации значений (поддерживает * и ?)"/>
            </StackPanel>

            <!-- Блок для режима ByPredicate -->
            <StackPanel Visibility="{Binding Prop_Target,
                                    Converter={StaticResource EnumToVisConverter},
                                    ConverterParameter=ByPredicate}">
                <TextBlock Text="Условие (лямбда):" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_Predicate, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="Лямбда-выражение для фильтрации: kvp => условие"/>
            </StackPanel>

            <TextBlock Text="Переменная-результат:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Result, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Имя переменной для сохранения отфильтрованного словаря"/>

        </StackPanel>
    </Grid>
</UserControl>
