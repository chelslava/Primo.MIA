<!--
    DictionaryContainsValue.xaml
    Визуальный интерфейс активности "Проверка наличия значения в словаре".

    Функции:
      - Проверка существования значения
      - Возврат булевого результата
-->
<UserControl x:Class="Primo.MIA.DictionaryContainsValue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="50"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/dict.png">

            <TextBlock Style="{StaticResource ActivityHeader}"
                       Text="Словарь: Проверить значение"/>

            <TextBlock Text="Словарь:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Dictionary, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Переменная со словарём для проверки"/>
    </local:ActivityPanel>
</UserControl>
