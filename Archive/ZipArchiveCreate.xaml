<UserControl x:Class="Primo.MIA.ZipArchiveCreate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="200" Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/folder.png"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="5,0,5,5">

            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="Архив: Создать ZIP"/>
            </TextBlock>

            <!-- Источники -->
            <TextBlock Text="Источники:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_SourcePaths, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="52"
                     ToolTip="Пути через точку с запятой: файлы, папки (рекурсивно), маски (*.tmp, report_*.pdf).&#xA;Пример: C:\data\reports; D:\logs\*.log"/>

            <!-- Архив (результат) -->
            <TextBlock Text="Архив (результат):" Style="{StaticResource FieldLabel}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtDestinationZip"
                         Grid.Column="0"
                         Text="{Binding Prop_DestinationZip, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         Margin="0,2,4,0"
                         ToolTip="Путь к создаваемому ZIP-файлу. Существующий архив пересоздаётся."/>
                <Button Grid.Column="1"
                        Style="{StaticResource BrowseButton}"
                        Content=""
                        Click="BtnBrowseZip_Click"
                        ToolTip="Выбрать файл...">
                    <Button.Background>
                        <ImageBrush ImageSource="/Primo.MIA;component/images/folder.png" TileMode="None"/>
                    </Button.Background>
                </Button>
            </Grid>

            <!-- Сжатие -->
            <TextBlock Text="Сжатие:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{local:EnumValues local:ArchiveCompressionLevel}"
                      SelectedValue="{Binding Prop_CompressionLevel}"
                      SelectedValuePath="Key"
                      DisplayMemberPath="Display"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Оптимальное — по умолчанию; Быстрое — для больших объёмов; Максимальное — медленно, минимальный размер"/>

            <!-- Выходные -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Путь архива (out): " VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                <TextBox Grid.Column="1" Text="{Binding Prop_ResultPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            </Grid>
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Файлов в архиве (out): " VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                <TextBox Grid.Column="1" Text="{Binding Prop_EntryCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            </Grid>

        </StackPanel>
    </Grid>
</UserControl>
