<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageReference Include="System.Text.Json" Version="10.0.2" />
    <PackageReference Include="xunit.extensibility.core" Version="2.9.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Primo.MIA.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xaml" />
    <Reference Include="LTools.Common">
      <HintPath>C:\Program Files\Primo\Primo Studio Community x64\LTools.Common.dll</HintPath>
    </Reference>
    <Reference Include="LTools.Dto">
      <HintPath>C:\Program Files\Primo\Primo Studio Community x64\LTools.Dto.dll</HintPath>
    </Reference>
    <Reference Include="LTools.Enums">
      <HintPath>C:\Program Files\Primo\Primo Studio Community x64\LTools.Enums.dll</HintPath>
    </Reference>
    <Reference Include="LTools.Scripting">
      <HintPath>C:\Program Files\Primo\Primo Studio Community x64\LTools.Scripting.dll</HintPath>
    </Reference>
    <Reference Include="LTools.SDK">
      <HintPath>C:\Program Files\Primo\Primo Studio Community x64\LTools.SDK.dll</HintPath>
    </Reference>
    <Reference Include="LTools.Workflow">
      <HintPath>C:\Program Files\Primo\Primo Studio Community x64\LTools.Workflow.dll</HintPath>
    </Reference>
    <Reference Include="Primo.Orchestrator.Client.Common">
      <HintPath>C:\Program Files\Primo\Primo Studio Community x64\Primo.Orchestrator.Client.Common.dll</HintPath>
    </Reference>
    <Reference Include="Primo.Orchestrator.Client.FW">
      <HintPath>C:\Program Files\Primo\Primo Studio Community x64\Primo.Orchestrator.Client.FW.dll</HintPath>
    </Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe">
      <HintPath>C:\Program Files\Microsoft Visual Studio\18\Enterprise\Common7\IDE\PublicAssemblies\System.Runtime.CompilerServices.Unsafe.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Копируем все DLL основного проекта в output тестов (для dotnet test) -->
  <!-- Исключаем System.Runtime.CompilerServices.Unsafe.dll (версия 6.0.3.0 из Visual Studio) -->
  <Target Name="CopyMainProjectOutput" AfterTargets="Build">
    <ItemGroup>
      <_MainProjectDlls Include="$(MSBuildProjectDirectory)\..\bin\$(Configuration)\*.dll"
                        Exclude="$(MSBuildProjectDirectory)\..\bin\$(Configuration)\System.Runtime.CompilerServices.Unsafe.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_MainProjectDlls)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
  <!-- Копируем правильную версию System.Runtime.CompilerServices.Unsafe (v6.0.3.0) -->
  <Target Name="CopyUnsafeDll" AfterTargets="CopyMainProjectOutput">
    <Copy SourceFiles="C:\Program Files\Microsoft Visual Studio\18\Enterprise\Common7\IDE\PublicAssemblies\System.Runtime.CompilerServices.Unsafe.dll"
          DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Update="calendar\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
