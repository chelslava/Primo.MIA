<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Primo.MIA</RootNamespace>
    <AssemblyName>Primo.MIA</AssemblyName>
    <Deterministic>true</Deterministic>
    <ComVisible>false</ComVisible>
    <NeutralLanguage>ru-RU</NeutralLanguage>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Отключить автоматическое создание bindingRedirects (используем явные в app.config) -->
    <AutoGenerateBindingRedirects>False</AutoGenerateBindingRedirects>

    <!-- Версионирование: ЕДИНСТВЕННЫЙ источник версии — <Version>.
         AssemblyVersion и FileVersion наследуются от неё без prerelease-суффикса
         (они принимают только числа), NuGet-пакет и InformationalVersion несут
         полный SemVer. При сборке из тега (/p:Version=x.y.z в release.yml) все
         версии меняются согласованно. InformationalVersion дополнительно
         содержит SHA коммита (SourceRevisionId). -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Primo.MIA</PackageId>
    <Version>1.7.0</Version>
    <AssemblyVersion>$(Version.Split('-')[0])</AssemblyVersion>
    <FileVersion>$(Version.Split('-')[0])</FileVersion>
    <Authors>Chelslava</Authors>
    <Description>Библиотека расширенных активностей для платформы Primo RPA (~130 активностей: Browser, Database, HTTP, SFTP, RabbitMQ, Crypto, Collections, Files, Calendar, Text, и другие)</Description>
    <PackageProjectUrl>https://github.com/chelslava/Primo.MIA</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chelslava/Primo.MIA</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>full</DebugType>
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- NuGet packages -->
    <!-- Reference-сборки .NET Framework 4.8.1 — позволяют собирать без установленного dev pack (CI) -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Selenium.WebDriver" Version="4.52.0" />
    <PackageReference Include="Selenium.Support" Version="4.52.0" />
    <PackageReference Include="Tomlyn" Version="2.4.0" />
    <PackageReference Include="MongoDB.Driver" Version="2.30.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.41" />
    <PackageReference Include="Npgsql" Version="7.0.8" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- SSH.NET 2026.0.0 тянет System.ValueTuple для net4x, но в .NET 4.8.1 эти типы
         уже встроены в mscorlib — исключаем активы пакета, иначе ошибка CS0433
         («тип ValueTuple существует в двух сборках»). -->
    <PackageReference Include="System.ValueTuple" Version="4.6.2" ExcludeAssets="all" />
    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />
    <!-- HtmlAgilityPack (issue #36): парсинг HTML-таблиц для HtmlTableToDataTable.
         Managed-only (без нативных библиотек) — дублей в nupkg быть не может,
         но контрольная проверка после сборки сохранена по уроку #19. -->
    <PackageReference Include="HtmlAgilityPack" Version="1.12.2" />
    <!-- NJsonSchema (issue #34): валидация/генерация JSON Schema.
         Managed-only (Newtonsoft.Json + Namotion.Reflection, оба транзитивно);
         Newtonsoft 13 уже в прямых зависимостях — конфликтов версий нет. -->
    <PackageReference Include="NJsonSchema" Version="11.6.2" />
    <!-- BouncyCastle.Cryptography (issue #35): OpenPGP для PGP-активностей.
         Уже приходил транзитивно через SSH.NET (>= 2.7.0) — новая зависимость
         пакета не добавляется, только явное закрепление версии. Managed-only. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- Kafka (issue #19): Confluent.Kafka 2.x — net472+/netstandard2.0;
         нативный librdkafka.redist подтягивается транзитивно.
         Явная ссылка с ExcludeAssets/PrivateAssets=all: без неё content-ассеты
         redist (нативные librdkafka/VC-редистрибутивы, ~11 МБ) дублируются в
         наш nupkg; у потребителя они приходят транзитивно через Confluent.Kafka -->
    <PackageReference Include="Confluent.Kafka" Version="2.12.0" />
    <PackageReference Include="librdkafka.redist" Version="2.12.0" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <!-- Local Primo SDK references (not available via NuGet).
       PrimoSdkPath можно переопределить: dotnet build /p:PrimoSdkPath="D:\SDK\Primo".
       По умолчанию — путь, куда CI устанавливает бандл SDK (см. AGENTS.md). -->
  <PropertyGroup>
    <PrimoSdkPath Condition="'$(PrimoSdkPath)' == ''">C:\Program Files\Primo\Primo Studio Community x64</PrimoSdkPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="LTools.Common">
      <HintPath>$(PrimoSdkPath)\LTools.Common.dll</HintPath>
    </Reference>
    <Reference Include="LTools.Dto">
      <HintPath>$(PrimoSdkPath)\LTools.Dto.dll</HintPath>
    </Reference>
    <Reference Include="LTools.Enums">
      <HintPath>$(PrimoSdkPath)\LTools.Enums.dll</HintPath>
    </Reference>
    <Reference Include="LTools.Office">
      <HintPath>$(PrimoSdkPath)\LTools.Office.dll</HintPath>
    </Reference>
    <Reference Include="LTools.Scripting">
      <HintPath>$(PrimoSdkPath)\LTools.Scripting.dll</HintPath>
    </Reference>
    <Reference Include="LTools.SDK">
      <HintPath>$(PrimoSdkPath)\LTools.SDK.dll</HintPath>
    </Reference>
    <Reference Include="LTools.Workflow">
      <HintPath>$(PrimoSdkPath)\LTools.Workflow.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Resource images: most need CopyToOutputDirectory for runtime access -->
  <ItemGroup>
    <None Remove="images\**\*" />
    <Resource Include="images\**\*" Exclude="images\dict.png;images\folder.png;images\json.png;images\bd.png" CopyToOutputDirectory="Always" />
    <Resource Include="images\dict.png" />
    <Resource Include="images\folder.png" />
    <Resource Include="images\json.png" />
    <Resource Include="images\bd.png" />
  </ItemGroup>

  <!-- Exclude test project files from default globs -->
  <ItemGroup>
    <Compile Remove="Primo.MIA.Tests\**" />
    <EmbeddedResource Remove="Primo.MIA.Tests\**" />
    <None Remove="Primo.MIA.Tests\**" />
  </ItemGroup>

  <!-- Doc files for NuGet package -->
  <ItemGroup>
    <None Include="doc\**\*" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Иконка пакета NuGet (issue #18): браузерная иконка проекта под нейтральным именем -->
    <None Include="images\browser.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>

</Project>
