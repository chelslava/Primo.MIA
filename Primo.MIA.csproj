<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Primo.MIA</RootNamespace>
    <AssemblyName>Primo.MIA</AssemblyName>
    <Deterministic>true</Deterministic>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ComVisible>false</ComVisible>
    <NeutralLanguage>ru-RU</NeutralLanguage>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- NuGet packaging -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Primo.MIA</PackageId>
    <Version>1.0.0</Version>
    <Authors>Chelslava</Authors>
    <Description>Библиотека расширенных активностей для платформы Primo RPA (~90 активностей: Browser, Database, HTTP, Collections, Files, Calendar, Text, и другие)</Description>
    <PackageProjectUrl>https://github.com/chelslava/Primo.MIA</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chelslava/Primo.MIA</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <OutputPath>bin\Debug\</OutputPath>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- NuGet packages -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Selenium.WebDriver" Version="4.41.0" />
    <PackageReference Include="Selenium.Support" Version="4.41.0" />
    <PackageReference Include="Tomlyn" Version="2.4.0" />
  </ItemGroup>

  <!-- Local Primo SDK references (not available via NuGet) -->
  <ItemGroup>
    <Reference Include="LTools.Common">
      <HintPath>C:\Program Files\Primo\Primo Studio Community x64\LTools.Common.dll</HintPath>
    </Reference>
    <Reference Include="LTools.Dto">
      <HintPath>C:\Program Files\Primo\Primo Studio Community x64\LTools.Dto.dll</HintPath>
    </Reference>
    <Reference Include="LTools.Enums">
      <HintPath>C:\Program Files\Primo\Primo Studio Community x64\LTools.Enums.dll</HintPath>
    </Reference>
    <Reference Include="LTools.Office">
      <HintPath>C:\Program Files\Primo\Primo Studio Community x64\LTools.Office.dll</HintPath>
    </Reference>
    <Reference Include="LTools.Scripting">
      <HintPath>C:\Program Files\Primo\Primo Studio Community x64\LTools.Scripting.dll</HintPath>
    </Reference>
    <Reference Include="LTools.SDK">
      <HintPath>C:\Program Files\Primo\Primo Studio Community x64\LTools.SDK.dll</HintPath>
    </Reference>
    <Reference Include="LTools.Workflow">
      <HintPath>C:\Program Files\Primo\Primo Studio Community x64\LTools.Workflow.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Resource images: most need CopyToOutputDirectory for runtime access -->
  <ItemGroup>
    <None Remove="images\**\*" />
    <Resource Include="images\**\*" Exclude="images\dict.png;images\folder.png;images\json.png;images\bd.png" CopyToOutputDirectory="Always" />
    <Resource Include="images\dict.png" />
    <Resource Include="images\folder.png" />
    <Resource Include="images\json.png" />
    <Resource Include="images\bd.png" />
  </ItemGroup>

  <!-- Exclude test project files from default globs -->
  <ItemGroup>
    <Compile Remove="Primo.MIA.Tests\**" />
    <EmbeddedResource Remove="Primo.MIA.Tests\**" />
    <None Remove="Primo.MIA.Tests\**" />
  </ItemGroup>

  <!-- Doc files for NuGet package -->
  <ItemGroup>
    <None Include="doc\**\*" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
