<!--
    TextParse.xaml
    Визуальный интерфейс активности «Текст: Разбор по шаблону».

    Блок «Все результаты» виден только при AllMatches = true —
    в режиме одного совпадения этот выходной параметр не нужен.
-->
<UserControl x:Class="Primo.MIA.TextParse"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="280"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/text.png">

            <!-- Заголовок с синтаксисом -->
            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="Текст: Разбор по шаблону ["/>
                <Run Text="{Binding Prop_MaskSyntax, Mode=OneWay, Converter={StaticResource EnumDisplayNameConverter}}" Foreground="{StaticResource AccentBrush}"/>
                <Run Text="]"/>
            </TextBlock>

            <!-- Входная строка -->
            <TextBlock Text="Входная строка:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_InputText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Строка для разбора по маске"/>

            <!-- Маска -->
            <TextBlock Text="Маска:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Mask, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Маска с плейсхолдерами. Пример: Счёт №{Номер} от {Дата}"/>

            <!-- Синтаксис и опции в одной строке -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="Синтаксис:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{local:EnumValues local:TemplateSyntax}" SelectedValue="{Binding Prop_MaskSyntax}" SelectedValuePath="Key" DisplayMemberPath="Display" 
                              Style="{StaticResource FieldComboBox}"
                              ToolTip="Синтаксис плейсхолдеров в маске"/>
                </StackPanel>

                <!-- Чекбоксы опций в правой колонке -->
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    <CheckBox Style="{StaticResource FieldCheckBox}" Content="Учитывать регистр"
                              IsChecked="{Binding Prop_CaseSensitive}"
                              Margin="0,2,0,2"
                              ToolTip="Учитывать регистр литеральных частей маски"/>
                    <CheckBox Style="{StaticResource FieldCheckBox}" Content="Жадный захват"
                              IsChecked="{Binding Prop_GreedyMatch}"
                              Margin="0,2,0,2"
                              ToolTip="Плейсхолдер захватывает максимально длинную подстроку"/>
                </StackPanel>
            </Grid>

            <!-- Многострочный и Все вхождения -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox Style="{StaticResource FieldCheckBox}" Grid.Column="0"
                          Content="Многострочный текст"
                          IsChecked="{Binding Prop_MultiLine}"
                          Margin="0,2,4,2"
                          ToolTip="Символ '.' в маске совпадает в том числе с переносом строки"/>

                <CheckBox Style="{StaticResource FieldCheckBox}" Grid.Column="1"
                          Content="Все вхождения"
                          IsChecked="{Binding Prop_AllMatches}"
                          Margin="4,2,0,2"
                          ToolTip="Найти все совпадения маски в тексте (заполняет «Все результаты»)"/>
            </Grid>
    </local:ActivityPanel>
</UserControl>
