<!--
    TextParse.xaml
    Визуальный интерфейс активности «Текст: Разбор по шаблону».

    Блок «Все результаты» виден только при AllMatches = true —
    в режиме одного совпадения этот выходной параметр не нужен.
-->
<UserControl x:Class="Primo.MIA.TextParse"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="280"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Значения синтаксиса плейсхолдеров -->
            <ObjectDataProvider x:Key="SyntaxValues"
                                MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:TemplateSyntax"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <!-- Конвертер для показа блока «Все результаты» только при AllMatches=true -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Иконка активности -->
        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/text.png"/>

        <!-- Поля активности -->
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Top"
                    Margin="5,0,5,8">

            <!-- Заголовок с синтаксисом -->
            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="Текст: Разбор по шаблону [" Foreground="#FF0E0E0E"/>
                <Run Text="{Binding Prop_MaskSyntax, Mode=OneWay}" Foreground="#FF1565C0"/>
                <Run Text="]" Foreground="#FF0E0E0E"/>
            </TextBlock>

            <!-- Входная строка -->
            <TextBlock Text="Входная строка:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_InputText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Строка для разбора по маске"/>

            <!-- Маска -->
            <TextBlock Text="Маска:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Mask, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Маска с плейсхолдерами. Пример: Счёт №{Номер} от {Дата}"/>

            <!-- Синтаксис и опции в одной строке -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="Синтаксис:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource SyntaxValues}}"
                              SelectedItem="{Binding Prop_MaskSyntax}"
                              Style="{StaticResource FieldComboBox}"
                              ToolTip="Синтаксис плейсхолдеров в маске"/>
                </StackPanel>

                <!-- Чекбоксы опций в правой колонке -->
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    <CheckBox Content="Учитывать регистр"
                              IsChecked="{Binding Prop_CaseSensitive}"
                              Margin="0,2,0,2"
                              ToolTip="Учитывать регистр литеральных частей маски"
                              Foreground="#FF0E0E0E"/>
                    <CheckBox Content="Жадный захват"
                              IsChecked="{Binding Prop_GreedyMatch}"
                              Margin="0,2,0,2"
                              ToolTip="Плейсхолдер захватывает максимально длинную подстроку"
                              Foreground="#FF0E0E0E"/>
                </StackPanel>
            </Grid>

            <!-- Многострочный и Все вхождения -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          Content="Многострочный текст"
                          IsChecked="{Binding Prop_MultiLine}"
                          Margin="0,2,4,2"
                          ToolTip="Символ '.' в маске совпадает в том числе с переносом строки"
                          Foreground="#FF0E0E0E"/>

                <CheckBox Grid.Column="1"
                          Content="Все вхождения"
                          IsChecked="{Binding Prop_AllMatches}"
                          Margin="4,2,0,2"
                          ToolTip="Найти все совпадения маски в тексте (заполняет «Все результаты»)"
                          Foreground="#FF0E0E0E"/>
            </Grid>

        </StackPanel>
    </Grid>
</UserControl>
