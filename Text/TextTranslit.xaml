<!--
    TextTranslit.xaml
    Визуальный интерфейс активности «Текст: Транслитерация».

    Поле «Замена пробелов» всегда видно — пользователь оставляет пустым
    если пробелы не нужно заменять.
    «К верхнему» и «К нижнему регистру» — взаимоисключающие чекбоксы.
-->
<UserControl x:Class="Primo.MIA.TextTranslit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="260"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/translit.png">

            <!-- Заголовок с направлением и схемой -->
            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="Текст: Транслитерация ["/>
                <Run Text="{Binding Prop_Scheme, Mode=OneWay, Converter={StaticResource EnumDisplayNameConverter}}" Foreground="{StaticResource AccentBrush}"/>
                <Run Text="]"/>
            </TextBlock>

            <!-- Входной текст -->
            <TextBlock Text="Входной текст:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_InputText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Текст для транслитерации"/>

            <!-- Направление и схема в одной строке -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="Направление:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{local:EnumValues local:TranslitDirection}" SelectedValue="{Binding Prop_Direction}" SelectedValuePath="Key" DisplayMemberPath="Display" 
                              Style="{StaticResource FieldComboBox}"
                              ToolTip="CyrillicToLatin / LatinToCyrillic / AutoDetect"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Схема:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{local:EnumValues local:TranslitScheme}" SelectedValue="{Binding Prop_Scheme}" SelectedValuePath="Key" DisplayMemberPath="Display" 
                              Style="{StaticResource FieldComboBox}"
                              ToolTip="Simplified / Passport2013 / GOST7792000 / ISO9 / BGN_PCGN / ICAO"/>
                </StackPanel>
            </Grid>

            <!-- Замена пробелов -->
            <!-- Постобработка: по одной на строку (узкая панель Studio) -->
            <TextBlock Text="Постобработка:" Style="{StaticResource FieldLabel}" Margin="0,4,0,0"/>
            <CheckBox Style="{StaticResource FieldCheckBox}" Margin="0,2,6,2"
                      Content="Сохранять регистр"
                      IsChecked="{Binding Prop_PreserveCase}"
                      ToolTip="Сохранять регистр оригинального символа"/>
            <CheckBox Style="{StaticResource FieldCheckBox}"
                      Content="К верхнему регистру"
                      IsChecked="{Binding Prop_ToUpperCase}"
                      ToolTip="Привести результат к верхнему регистру"/>
            <CheckBox Style="{StaticResource FieldCheckBox}"
                      Content="К нижнему регистру"
                      IsChecked="{Binding Prop_ToLowerCase}"
                      ToolTip="Привести результат к нижнему регистру"/>

            <!-- Замена пробелов -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Замена пробелов:" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"
                           ToolTip="Заменить пробелы: _ для файлов, . для логинов, пусто = оставить"/>
                <TextBox Grid.Column="1" Text="{Binding Prop_ReplaceSpaces, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="Пусто = оставить пробелы без изменений"/>
            </Grid>

            <!-- Сохранять нетранслитерируемые символы -->
            <CheckBox Style="{StaticResource FieldCheckBox}" Content="Сохранять нетранслитерируемые символы"
                      IsChecked="{Binding Prop_PreserveNonAlpha}"
                      Margin="0,6,0,2"
                      ToolTip="Оставлять цифры, знаки пунктуации и пробелы без изменений"/>
    </local:ActivityPanel>
</UserControl>
