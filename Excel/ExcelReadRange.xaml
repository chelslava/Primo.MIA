<UserControl x:Class="Primo.MIA.ExcelReadRange"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d" d:DesignHeight="260" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/excel.png">
            <TextBlock Text="Excel: Прочитать диапазон" Style="{StaticResource ActivityHeader}"/>

            <TextBlock Text="Файл (.xlsx):" Style="{StaticResource FieldLabel}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtFilePath"
                         Grid.Column="0"
                         Text="{Binding Prop_FilePath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         Margin="0,2,4,0"
                         ToolTip="Путь к файлу .xlsx (не Interop — Excel не требуется)"/>
                <Button Grid.Column="1"
                        Style="{StaticResource BrowseButton}"
                        Content=""
                        Click="BtnBrowseXlsx_Click"
                        ToolTip="Выбрать файл Excel...">
                    <Button.Background>
                        <ImageBrush ImageSource="/Primo.MIA;component/images/folder.png" TileMode="None"/>
                    </Button.Background>
                </Button>
            </Grid>

            <TextBlock Text="Лист:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_SheetName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Имя листа; пусто — первый лист книги"/>

            <TextBlock Text="Диапазон:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Range, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Диапазон, например A1:F100; пусто — используемый диапазон листа"/>

            <CheckBox Style="{StaticResource FieldCheckBox}" Margin="0,4,6,2"
                      Content="Первая строка — заголовки колонок"
                      ToolTip="Имена колонок DataTable берутся из первой строки диапазона; иначе — «Колонка1…N»"
                      IsChecked="{Binding Prop_HeaderRow}"/>

            <TextBlock Text="Результат (DataTable):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ResultTable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Переменная (DataTable) для результата; значения типизированы: числа → Double, даты → DateTime"/>

            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Кол-во строк:" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                <TextBox Grid.Column="1" Text="{Binding Prop_RowCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                         ToolTip="Переменная (Int32) для числа прочитанных строк"/>
                <TextBlock Grid.Column="2" Text="Колонки:" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                <TextBox Grid.Column="3" Text="{Binding Prop_ColumnNames, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                         ToolTip="Переменная (List&lt;string&gt;) для имён колонок"/>
            </Grid>
        </local:ActivityPanel>
</UserControl>
