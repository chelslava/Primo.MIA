<UserControl x:Class="Primo.MIA.ExcelWriteRange"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d" d:DesignHeight="360" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="32" Height="32" Margin="5" VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/excel.png"/>
        <StackPanel Grid.Column="1" Margin="5,0,5,5">
            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="Excel: Записать диапазон ["/>
                <Run Text="{Binding Prop_Mode, Mode=OneWay, Converter={StaticResource EnumDisplayNameConverter}}" Foreground="{StaticResource AccentBrush}"/>
                <Run Text="]"/>
            </TextBlock>

            <TextBlock Text="Файл (.xlsx):" Style="{StaticResource FieldLabel}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtFilePath"
                         Grid.Column="0"
                         Text="{Binding Prop_FilePath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         Margin="0,2,4,0"
                         ToolTip="Путь к .xlsx; создаётся при отсутствии (см. чекбокс ниже)"/>
                <Button Grid.Column="1"
                        Style="{StaticResource BrowseButton}"
                        Content=""
                        Click="BtnBrowseXlsx_Click"
                        ToolTip="Выбрать файл Excel...">
                    <Button.Background>
                        <ImageBrush ImageSource="/Primo.MIA;component/images/folder.png" TileMode="None"/>
                    </Button.Background>
                </Button>
            </Grid>

            <TextBlock Text="Лист:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_SheetName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Имя листа; пусто — первый лист; создаётся при отсутствии"/>

            <TextBlock Text="Таблица (DataTable):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Table, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Переменная (DataTable) для записи"/>

            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Режим записи:" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{local:EnumValues local:ExcelWriteMode}"
                          SelectedValue="{Binding Prop_Mode}" SelectedValuePath="Key" DisplayMemberPath="Display"
                          Style="{StaticResource FieldComboBox}"
                          ToolTip="Перезаписать — от начальной ячейки; Дописать — после последней занятой строки"/>
            </Grid>

            <!-- Начальная ячейка — только для режима перезаписи -->
            <StackPanel Margin="0,2,0,0"
                        Visibility="{Binding Prop_Mode,
                                     Converter={StaticResource MultiEnumToVisConverter},
                                     ConverterParameter=Overwrite}">
                <TextBlock Text="Начальная ячейка:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_StartCell, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                         ToolTip="Например A1; сюда встанет первая строка данных (или заголовки)"/>
            </StackPanel>

            <CheckBox Style="{StaticResource FieldCheckBox}" Margin="0,4,6,2"
                      Content="Записать заголовки колонок"
                      ToolTip="Первая строка — имена колонок DataTable"
                      IsChecked="{Binding Prop_WriteHeaders}"/>

            <CheckBox Style="{StaticResource FieldCheckBox}" Margin="0,2,6,2"
                      Content="Создавать файл/лист при отсутствии"
                      ToolTip="Выключено — ошибка, если файла/листа нет"
                      IsChecked="{Binding Prop_CreateIfMissing}"/>

            <TextBlock Text="Записано строк:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_WrittenRows, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Переменная (Int32) для числа записанных строк данных (без заголовков)"/>
        </StackPanel>
    </Grid>
</UserControl>
