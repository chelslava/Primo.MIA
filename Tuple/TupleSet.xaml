<!--
    TupleSet.xaml
    Визуальный интерфейс активности "Установка элемента кортежа".

    Функции:
      - Установка значения элемента по индексу
      - Возврат обновлённого кортежа
-->
<UserControl x:Class="Primo.MIA.TupleSet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="50"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/tuple.png">

            <TextBlock Style="{StaticResource ActivityHeader}"
                       Text="Кортеж: Установить элемент"/>

            <TextBlock Text="Кортеж:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Tuple, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Переменная с кортежем"/>
    </local:ActivityPanel>
</UserControl>
