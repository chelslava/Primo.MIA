<!--
    TupleUnzip.xaml
    Визуальный интерфейс активности "Разъединение списка кортежей".

    Функции:
      - Преобразование списка кортежей в отдельные списки
      - Поддержка кортежей различной арности
-->
<UserControl x:Class="Primo.MIA.TupleUnzip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="50"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/tuple.png">

            <TextBlock Style="{StaticResource ActivityHeader}"
                       Text="Кортеж: Разъединить"/>

            <TextBlock Text="Список кортежей:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_TupleList, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Переменная со списком кортежей для разъединения"/>
    </local:ActivityPanel>
</UserControl>
