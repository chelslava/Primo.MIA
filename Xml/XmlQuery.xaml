<UserControl x:Class="Primo.MIA.XmlQuery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d" 
             d:DesignHeight="80" Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Иконка -->
        <Image Grid.Column="0" Width="32" Height="32" Margin="5" VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/http.png"/>

        <!-- Содержимое -->
        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="5,0,5,5">
            <!-- Заголовок -->
            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="XML: XPath запрос ["/>
                <Run Text="{Binding Prop_QueryMode, Mode=OneWay, Converter={StaticResource EnumDisplayNameConverter}}"/>
                <Run Text="]"/>
            </TextBlock>

            <!-- Режим -->
            <ComboBox ItemsSource="{local:EnumValues local:XmlQueryMode}" SelectedValue="{Binding Prop_QueryMode}" SelectedValuePath="Key" DisplayMemberPath="Display"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Формат результата: одно значение / список всех совпадений / количество"/>

            <!-- XPath -->
            <TextBox Text="{Binding Prop_XPath, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="XPath-выражение, например /root/item[@id='1'] или //item/text()"/>
        </StackPanel>
    </Grid>
</UserControl>
