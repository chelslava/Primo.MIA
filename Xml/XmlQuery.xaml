<UserControl x:Class="Primo.MIA.XmlQuery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d" 
             d:DesignHeight="80" Margin="0,0,0,5">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="QueryModeValues" MethodName="GetValues"
                            ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:XmlQueryMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Иконка -->
        <Image Grid.Column="0" Width="32" Height="32" Margin="5" VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/http.png"/>

        <!-- Содержимое -->
        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="5,0,5,5">
            <!-- Заголовок -->
            <TextBlock FontWeight="Bold" FontSize="12" Foreground="#FF0E0E0E">
                <Run Text="XML: XPath запрос ["/>
                <Run Text="{Binding Prop_QueryMode, Mode=OneWay}"/>
                <Run Text="]"/>
            </TextBlock>

            <!-- Режим -->
            <ComboBox ItemsSource="{Binding Source={StaticResource QueryModeValues}}"
                      SelectedItem="{Binding Prop_QueryMode}"
                      Height="20" Margin="0,2,0,0" FontSize="11"/>

            <!-- XPath -->
            <TextBox Text="{Binding Prop_XPath, UpdateSourceTrigger=PropertyChanged}"
                     Height="20" FontSize="11" Margin="0,2,0,0"
                     BorderThickness="0" BorderBrush="#D0D7E2"/>
        </StackPanel>
    </Grid>
</UserControl>
