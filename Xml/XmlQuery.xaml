<UserControl x:Class="Primo.MIA.XmlQuery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d" 
             d:DesignHeight="80" Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/xml.png">
            <!-- Заголовок -->
            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="XML: XPath запрос ["/>
                <Run Text="{Binding Prop_QueryMode, Mode=OneWay, Converter={StaticResource EnumDisplayNameConverter}}" Foreground="{StaticResource AccentBrush}"/>
                <Run Text="]"/>
            </TextBlock>

            <!-- Режим -->
            <ComboBox ItemsSource="{local:EnumValues local:XmlQueryMode}" SelectedValue="{Binding Prop_QueryMode}" SelectedValuePath="Key" DisplayMemberPath="Display"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Формат результата: одно значение / список всех совпадений / количество"/>

            <!-- XPath -->
            <TextBox Text="{Binding Prop_XPath, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="XPath-выражение, например /root/item[@id='1'] или //item/text()"/>
    </local:ActivityPanel>
</UserControl>
