<UserControl x:Class="Primo.MIA.SftpUpload"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:Primo.MIA"
             mc:Ignorable="d" xmlns:local="clr-namespace:Primo.MIA" d:DesignHeight="220" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/folder.png">
            <TextBlock Text="SFTP: Загрузить файл" Style="{StaticResource ActivityHeader}"/>
            <TextBlock Text="Хост:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Хост SFTP-сервера, например sftp.example.com (порт — в панели свойств, по умолчанию 22)"/>
            <TextBlock Text="Пользователь:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_UserName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Имя пользователя для SFTP-подключения"/>
            <TextBlock Text="Пароль:" Style="{StaticResource FieldLabel}"/>
            <PasswordBox common:PasswordBoxHelper.BindPassword="True"
                         common:PasswordBoxHelper.BoundPassword="{Binding Prop_Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldPasswordBox}"
                         ToolTip="Пароль SFTP (для подключения по ключу — приватный ключ и passphrase в панели свойств)"/>
            <TextBlock Text="Удалённый путь:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_RemotePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Путь назначения на сервере, например /uploads/data.csv"/>
            <TextBlock Text="Локальный путь:" Style="{StaticResource FieldLabel}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtLocalPath"
                         Grid.Column="0"
                         Text="{Binding Prop_LocalPath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         Margin="0,2,4,0"
                         ToolTip="Локальный файл для загрузки на сервер"/>
                <Button Grid.Column="1"
                        Style="{StaticResource BrowseButton}"
                        Content=""
                        Click="BtnBrowseFile_Click"
                        ToolTip="Выбрать файл...">
                    <Button.Background>
                        <ImageBrush ImageSource="/Primo.MIA;component/images/folder.png" TileMode="None"/>
                    </Button.Background>
                </Button>
            </Grid>
    </local:ActivityPanel>
</UserControl>
