<UserControl x:Class="Primo.MIA.KafkaConsumeBatch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:Primo.MIA"
             mc:Ignorable="d" xmlns:local="clr-namespace:Primo.MIA" d:DesignHeight="280" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/queue.png">
            <TextBlock Text="Kafka: Получить пакет" Style="{StaticResource ActivityHeader}"/>
            <TextBlock Text="Bootstrap-серверы:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_BootstrapServers, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Адреса кластера Kafka через запятую: host1:9092,host2:9092 (протокол безопасности и SASL — в панели свойств)"/>
            <TextBlock Text="Топик:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Topic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Имя топика Kafka"/>
            <TextBlock Text="Group ID:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_GroupId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Consumer-группа: сообщения распределяются по группам; начальное смещение, Auto Commit и коммит пакета — в панели свойств"/>
            <TextBlock Text="Максимум сообщений:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_MaxMessages, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Размер пакета (по умолчанию 10)"/>
            <TextBlock Text="Таймаут пакета (сек):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Общий таймаут ожидания пакета (по умолчанию 30); меньше — если сообщений меньше"/>
            <TextBlock Text="Сообщения (out):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Messages, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Выходная переменная List&lt;string&gt;: тела сообщений"/>
            <TextBlock Text="Пакет (метаданные) (out):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_MessagesInfo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="DataTable: topic, partition, offset, key, body"/>
            <TextBlock Text="Получено (out):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Count, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
    </local:ActivityPanel>
</UserControl>