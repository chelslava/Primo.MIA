<UserControl x:Class="Primo.MIA.KafkaPublish"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:Primo.MIA"
             mc:Ignorable="d" xmlns:local="clr-namespace:Primo.MIA" d:DesignHeight="220" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/queue.png">
            <TextBlock Text="Kafka: Отправить сообщение" Style="{StaticResource ActivityHeader}"/>
            <TextBlock Text="Bootstrap-серверы:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_BootstrapServers, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Адреса кластера Kafka через запятую: host1:9092,host2:9092 (протокол безопасности и SASL — в панели свойств)"/>
            <TextBlock Text="Топик:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Topic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Имя топика Kafka"/>
            <TextBlock Text="Ключ:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Key, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Ключ сообщения — определяет партицию (одинаковый ключ попадает в одну партицию); пусто — round-robin"/>
            <TextBlock Text="Сообщение:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Message, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Значение сообщения (UTF-8); JSON передаётся как текст (формат — в панели свойств)"/>
    </local:ActivityPanel>
</UserControl>
