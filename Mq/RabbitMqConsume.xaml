<UserControl x:Class="Primo.MIA.RabbitMqConsume"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:Primo.MIA"
             mc:Ignorable="d" d:DesignHeight="220" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="32" Height="32" Margin="5" VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/http.png"/>
        <StackPanel Grid.Column="1" Margin="5,0,5,5">
            <TextBlock Text="RabbitMQ: Получить сообщение" Style="{StaticResource ActivityHeader}"/>
            <TextBlock Text="Хост:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Хост RabbitMQ (порт, VirtualHost и TLS — в панели свойств; порт по умолчанию 5672, TLS — 5671)"/>
            <TextBlock Text="Пользователь:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_UserName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Имя пользователя для подключения к RabbitMQ"/>
            <TextBlock Text="Пароль:" Style="{StaticResource FieldLabel}"/>
            <PasswordBox common:PasswordBoxHelper.BindPassword="True"
                         common:PasswordBoxHelper.BoundPassword="{Binding Prop_Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldPasswordBox}"
                         ToolTip="Пароль пользователя RabbitMQ"/>
            <TextBlock Text="Очередь:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Queue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Имя очереди, из которой читается сообщение"/>
            <TextBlock Text="Тело сообщения:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_MessageBody, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Переменная (String) для тела полученного сообщения"/>
        </StackPanel>
    </Grid>
</UserControl>
