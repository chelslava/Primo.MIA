<UserControl x:Class="Primo.MIA.RabbitMqDeclareQueue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:Primo.MIA"
             mc:Ignorable="d" xmlns:local="clr-namespace:Primo.MIA" d:DesignHeight="260" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/http.png">
            <TextBlock Text="RabbitMQ: Объявить очередь" Style="{StaticResource ActivityHeader}"/>
            <TextBlock Text="Хост:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Хост RabbitMQ (порт, TLS, VirtualHost — в панели свойств)"/>
            <TextBlock Text="Пользователь:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_UserName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            <TextBlock Text="Пароль:" Style="{StaticResource FieldLabel}"/>
            <PasswordBox common:PasswordBoxHelper.BindPassword="True"
                         common:PasswordBoxHelper.BoundPassword="{Binding Prop_Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldPasswordBox}"/>
            <TextBlock Text="Очередь:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Queue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Имя очереди"/>
            <CheckBox Style="{StaticResource FieldCheckBox}" Margin="0,6,6,2"
                      Content="Durable (переживает перезапуск брокера)"
                      IsChecked="{Binding Prop_Durable}"/>
            <CheckBox Style="{StaticResource FieldCheckBox}"
                      Content="Exclusive (одно подключение)"
                      IsChecked="{Binding Prop_Exclusive}"/>
            <CheckBox Style="{StaticResource FieldCheckBox}"
                      Content="Auto Delete (удалить при отключении потребителей)"
                      IsChecked="{Binding Prop_AutoDelete}"/>
            <TextBlock Text="Привязать к Exchange:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_BindToExchange, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Пусто — не привязывать"/>
            <TextBlock Text="Routing Key:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_RoutingKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Ключ привязки (пусто = все сообщения exchange)"/>
            <TextBlock Text="Сообщений в очереди (out):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_MessageCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
    </local:ActivityPanel>
</UserControl>