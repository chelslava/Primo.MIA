<UserControl x:Class="Primo.MIA.RabbitMqDeclareQueue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:Primo.MIA"
             mc:Ignorable="d" d:DesignHeight="260" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="32" Height="32" Margin="5" VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/http.png"/>
        <StackPanel Grid.Column="1" Margin="5,0,5,5">
            <TextBlock Text="RabbitMQ: РћР±СЉСЏРІРёС‚СЊ РѕС‡РµСЂРµРґСЊ" Style="{StaticResource ActivityHeader}"/>
            <TextBlock Text="РҐРѕСЃС‚:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="РҐРѕСЃС‚ RabbitMQ (РїРѕСЂС‚, TLS, VirtualHost вЂ” РІ РїР°РЅРµР»Рё СЃРІРѕР№СЃС‚РІ)"/>
            <TextBlock Text="РџРѕР»СЊР·РѕРІР°С‚РµР»СЊ:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_UserName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            <TextBlock Text="РџР°СЂРѕР»СЊ:" Style="{StaticResource FieldLabel}"/>
            <PasswordBox common:PasswordBoxHelper.BindPassword="True"
                         common:PasswordBoxHelper.BoundPassword="{Binding Prop_Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldPasswordBox}"/>
            <TextBlock Text="РћС‡РµСЂРµРґСЊ:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Queue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="РРјСЏ РѕС‡РµСЂРµРґРё"/>
            <CheckBox Style="{StaticResource FieldCheckBox}" Margin="0,6,6,2"
                      Content="Durable (РїРµСЂРµР¶РёРІР°РµС‚ РїРµСЂРµР·Р°РїСѓСЃРє Р±СЂРѕРєРµСЂР°)"
                      IsChecked="{Binding Prop_Durable}"/>
            <CheckBox Style="{StaticResource FieldCheckBox}"
                      Content="Exclusive (РѕРґРЅРѕ РїРѕРґРєР»СЋС‡РµРЅРёРµ)"
                      IsChecked="{Binding Prop_Exclusive}"/>
            <CheckBox Style="{StaticResource FieldCheckBox}"
                      Content="Auto Delete (СѓРґР°Р»РёС‚СЊ РїСЂРё РѕС‚РєР»СЋС‡РµРЅРёРё РїРѕС‚СЂРµР±РёС‚РµР»РµР№)"
                      IsChecked="{Binding Prop_AutoDelete}"/>
            <TextBlock Text="РџСЂРёРІСЏР·Р°С‚СЊ Рє Exchange:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_BindToExchange, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="РџСѓСЃС‚Рѕ вЂ” РЅРµ РїСЂРёРІСЏР·С‹РІР°С‚СЊ"/>
            <TextBlock Text="Routing Key:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_RoutingKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="РљР»СЋС‡ РїСЂРёРІСЏР·РєРё (РїСѓСЃС‚Рѕ = РІСЃРµ СЃРѕРѕР±С‰РµРЅРёСЏ exchange)"/>
            <TextBlock Text="РЎРѕРѕР±С‰РµРЅРёР№ РІ РѕС‡РµСЂРµРґРё (out):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_MessageCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
        </StackPanel>
    </Grid>
</UserControl>