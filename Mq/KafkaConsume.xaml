<UserControl x:Class="Primo.MIA.KafkaConsume"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:Primo.MIA"
             mc:Ignorable="d" d:DesignHeight="220" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="32" Height="32" Margin="5" VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/http.png"/>
        <StackPanel Grid.Column="1" Margin="5,0,5,5">
            <TextBlock Text="Kafka: Получить сообщение" Style="{StaticResource ActivityHeader}"/>
            <TextBlock Text="Bootstrap-серверы:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_BootstrapServers, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Адреса кластера Kafka через запятую: host1:9092,host2:9092 (протокол безопасности и SASL — в панели свойств)"/>
            <TextBlock Text="Топик:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Topic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Имя топика Kafka"/>
            <TextBlock Text="Group ID:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_GroupId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Consumer-группа: сообщения распределяются по группам; начальное смещение и Auto Commit — в панели свойств"/>
            <TextBlock Text="Таймаут ожидания (сек):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Сколько секунд ждать сообщение; по истечении HasMessage = False без исключения"/>
        </StackPanel>
    </Grid>
</UserControl>
