<UserControl x:Class="Primo.MIA.RabbitMqPublish"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:Primo.MIA"
             mc:Ignorable="d" xmlns:local="clr-namespace:Primo.MIA" d:DesignHeight="220" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/http.png">
            <TextBlock Text="RabbitMQ: Отправить сообщение" Style="{StaticResource ActivityHeader}"/>
            <TextBlock Text="Хост:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Хост RabbitMQ (порт, VirtualHost и TLS — в панели свойств; порт по умолчанию 5672, TLS — 5671)"/>
            <TextBlock Text="Пользователь:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_UserName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Имя пользователя для подключения к RabbitMQ"/>
            <TextBlock Text="Пароль:" Style="{StaticResource FieldLabel}"/>
            <PasswordBox common:PasswordBoxHelper.BindPassword="True"
                         common:PasswordBoxHelper.BoundPassword="{Binding Prop_Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldPasswordBox}"
                         ToolTip="Пароль пользователя RabbitMQ"/>
            <TextBlock Text="Exchange:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Exchange, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Имя exchange для публикации; пусто — exchange по умолчанию"/>
            <TextBlock Text="Routing Key:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_RoutingKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Routing key — ключ маршрутизации сообщения к очереди"/>
            <TextBlock Text="Тело сообщения:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Body, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Текст публикуемого сообщения (persistent-доставка — в панели свойств)"/>
    </local:ActivityPanel>
</UserControl>
