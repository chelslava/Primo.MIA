<!--
    ListSet.xaml
    Визуальный интерфейс активности "Теория множеств для списков".

    Операции:
      - Union: Объединение
      - Intersect: Пересечение
      - Except: Разность
      - SymmetricExcept: Симметрическая разность
-->
<UserControl x:Class="Primo.MIA.ListSet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="80"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
        </ResourceDictionary>
    </UserControl.Resources>

    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/list.png">

            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="Список: Теория множеств ["/>
                <Run Text="{Binding Operation, Mode=OneWay, Converter={StaticResource EnumDisplayNameConverter}}" Foreground="{StaticResource AccentBrush}"/>
                <Run Text="]"/>
            </TextBlock>

            <ComboBox ItemsSource="{local:EnumValues local:ListSetOperation}" SelectedValue="{Binding Operation}" SelectedValuePath="Key" DisplayMemberPath="Display" 
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Операция: Union, Intersect, Except, SymmetricExcept"/>

            <TextBlock Text="Список A:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ListA, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Первый список для операции"/>
    </local:ActivityPanel>
</UserControl>
