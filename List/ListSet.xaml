<!--
    ListSet.xaml
    Визуальный интерфейс активности "Теория множеств для списков".

    Операции:
      - Union: Объединение
      - Intersect: Пересечение
      - Except: Разность
      - SymmetricExcept: Симметрическая разность
-->
<UserControl x:Class="Primo.MIA.ListSet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="80"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <ObjectDataProvider x:Key="OperationValues"
                                MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:ListSetOperation"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/list.png"/>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Top"
                    Margin="5,0,5,5">

            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="Список: Теория множеств ["/>
                <Run Text="{Binding Operation, Mode=OneWay}"/>
                <Run Text="]"/>
            </TextBlock>

            <ComboBox ItemsSource="{Binding Source={StaticResource OperationValues}}"
                      SelectedItem="{Binding Operation}"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Операция: Union, Intersect, Except, SymmetricExcept"/>

            <TextBlock Text="Список A:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ListA, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Первый список для операции"/>

        </StackPanel>
    </Grid>
</UserControl>
