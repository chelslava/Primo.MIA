<UserControl x:Class="Primo.MIA.DataTablePivot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:common="clr-namespace:Primo.MIA"
             mc:Ignorable="d" xmlns:local="clr-namespace:Primo.MIA" d:DesignHeight="340" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/table.png">
            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="DataTable: Pivot / Unpivot ["/>
                <Run Text="{Binding Prop_Mode, Mode=OneWay, Converter={StaticResource EnumDisplayNameConverter}}" Foreground="{StaticResource AccentBrush}"/>
                <Run Text="]"/>
            </TextBlock>
            <TextBlock Text="Режим:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{common:EnumValues common:DataTablePivotMode}"
                      SelectedValue="{Binding Prop_Mode}"
                      SelectedValuePath="Key"
                      DisplayMemberPath="Display"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Pivot — сводная; Unpivot — разбор сводной"/>
            <TextBlock Text="Исходная таблица:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_SourceTable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            <StackPanel Visibility="{Binding Prop_Mode,
                                    Converter={StaticResource EnumToVisConverter},
                                    ConverterParameter=Pivot}">
                <TextBlock Text="Колонка строк:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_RowKeyColumn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                         ToolTip="Уникальные значения → строки результата"/>
                <TextBlock Text="Pivot-колонка:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_PivotColumn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                         ToolTip="Уникальные значения → колонки результата"/>
                <TextBlock Text="Колонка значений:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_ValueColumn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                <TextBlock Text="Агрегат:" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{common:EnumValues common:DataTableAggregation}"
                          SelectedValue="{Binding Prop_Aggregation}"
                          SelectedValuePath="Key"
                          DisplayMemberPath="Display"
                          Style="{StaticResource FieldComboBox}"
                          ToolTip="Сумма / Количество / Минимум / Максимум / Первое"/>
            </StackPanel>
            <StackPanel Visibility="{Binding Prop_Mode,
                                    Converter={StaticResource EnumToVisConverter},
                                    ConverterParameter=Unpivot}">
                <TextBlock Text="Ключевые колонки:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_KeyColumns, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                         ToolTip="Копируются в каждую строку, через запятую: Дата,Регион"/>
                <TextBlock Text="Разворачиваемые колонки:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_ValueColumns, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                         ToolTip="Их имена и значения → строки, через запятую: Январь,Февраль,Март"/>
                <TextBlock Text="Имя колонки параметра:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_VariableColumnName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                         ToolTip="По умолчанию «Параметр»"/>
                <TextBlock Text="Имя колонки значения:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_ValueColumnName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                         ToolTip="По умолчанию «Значение»"/>
            </StackPanel>
            <TextBlock Text="Результат (out):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Result, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
    </local:ActivityPanel>
</UserControl>