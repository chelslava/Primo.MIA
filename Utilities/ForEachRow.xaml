<UserControl x:Class="Primo.MIA.ForEachRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:WFItems="clr-namespace:LTools.Common.WFItems;assembly=LTools.Common"
             xmlns:ui="clr-namespace:LTools.Common.UIElements;assembly=LTools.Common"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="420" Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="32" Height="32" Margin="5" VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/loop.png"/>
        <StackPanel Grid.Column="1" Margin="5,0,5,5">

            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="Таблица: Для каждой строки"/>
            </TextBlock>

            <TextBlock Text="Таблица:" Style="{StaticResource FieldLabel}" Margin="0,4,0,0"/>
            <TextBox Text="{Binding Prop_Table, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Переменная DataTable для перебора строк"/>

            <TextBlock Text="Текущая строка (out):" Style="{StaticResource FieldLabel}" Margin="0,4,0,0"/>
            <TextBox Text="{Binding Prop_CurrentRow, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Переменная (DataRow) — строка текущей итерации"/>

            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Индекс (out):" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                <TextBox Grid.Column="1" Text="{Binding Prop_RowIndex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                         ToolTip="Переменная (Int32) — индекс строки, начиная с 0"/>
                <TextBlock Grid.Column="2" Text="Колонок (out):" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="8,0,4,0"/>
                <TextBox Grid.Column="3" Text="{Binding Prop_ColumnCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                         ToolTip="Переменная (Int32) — число колонок таблицы"/>
            </Grid>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Пропустить строк:" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                <TextBox Grid.Column="1" Text="{Binding Prop_SkipRows, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                         ToolTip="Пропустить первые N строк (0 — с начала)"/>
                <TextBlock Grid.Column="2" Text="Максимум:" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="8,0,4,0"/>
                <TextBox Grid.Column="3" Text="{Binding Prop_MaxRows, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                         ToolTip="Ограничить число итераций (0 — без ограничения)"/>
            </Grid>

            <CheckBox Content="Отладочная пауза" Margin="0,6,0,0"
                      IsChecked="{Binding Prop_DebugPause}"
                      Style="{StaticResource FieldCheckBox}"
                      ToolTip="Перед каждой итерацией — окно «Продолжить / Прервать цикл» со значениями строки"/>

            <!-- Контейнер дочерних активностей (тело цикла) -->
            <Grid Margin="0,10,0,0">
                <Border BorderThickness="1"
                        CornerRadius="0,0,0,0"
                        Padding="{x:Static ui:WFElementBase.ContainerPadding}"
                        Background="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}">
                    <WFItems:WFContainerBase x:Name="cntBody" />
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
