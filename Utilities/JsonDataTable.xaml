<!--
    JsonDataTable.xaml
    Визуальный интерфейс активности «JSON: DataTable конвертер».

    Блок DataTable виден только при DataTableToJson.
    Блок JSON виден только при JsonToDataTable.
    Формат JSON виден только при DataTableToJson.
    Определять типы колонок видно только при JsonToDataTable.
    NULL как — только при DataTableToJson.
-->
<UserControl x:Class="Primo.MIA.JsonDataTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="300"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Иконка -->
        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/json.png"/>

        <!-- Поля -->
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Top"
                    Margin="5,0,5,8">

            <!-- Заголовок с направлением -->
            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="JSON: ["/>
                <Run Text="{Binding Prop_Direction, Mode=OneWay, Converter={StaticResource EnumDisplayNameConverter}}" Foreground="{StaticResource AccentBrush}"/>
                <Run Text="]"/>
            </TextBlock>

            <!-- Направление -->
            <TextBlock Text="Направление:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{local:EnumValues local:JsonConvertDirection}" SelectedValue="{Binding Prop_Direction}" SelectedValuePath="Key" DisplayMemberPath="Display" 
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="DataTableToJson — таблица в JSON&#xA;JsonToDataTable — JSON в таблицу"/>

            <!-- DataTable — виден только при DataTableToJson -->
            <StackPanel Visibility="{Binding Prop_Direction,
                        Converter={StaticResource EnumToVisConverter},
                        ConverterParameter=DataTableToJson}">
                <TextBlock Text="DataTable (входная):" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_DataTable, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="Переменная DataTable для конвертации в JSON"/>
            </StackPanel>

            <!-- JSON — виден только при JsonToDataTable -->
            <StackPanel Visibility="{Binding Prop_Direction,
                        Converter={StaticResource EnumToVisConverter},
                        ConverterParameter=JsonToDataTable}">
                <TextBlock Text="JSON (входной):" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_Json, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         AcceptsReturn="True"
                         MinHeight="44"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         ToolTip="JSON-строка или переменная скрипта содержащая JSON"/>
            </StackPanel>

            <!-- Колонки и формат дат в одной строке -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="Колонки (пусто = все):" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Prop_Columns, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldBox}"
                             ToolTip="Имена колонок через запятую. Пример: Id,Name,Amount&#xA;Пусто = все колонки"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Формат дат:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Prop_DateFormat, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldBox}"
                             ToolTip="Формат DateTime-колонок. Примеры:&#xA;  yyyy-MM-dd&#xA;  dd.MM.yyyy&#xA;  yyyy-MM-ddTHH:mm:ss"/>
                </StackPanel>
            </Grid>

            <!-- Формат JSON + NULL Mode — только при DataTableToJson -->
            <StackPanel Visibility="{Binding Prop_Direction,
                        Converter={StaticResource EnumToVisConverter},
                        ConverterParameter=DataTableToJson}">
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="Формат JSON:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{local:EnumValues local:JsonTableFormat}" SelectedValue="{Binding Prop_Format}" SelectedValuePath="Key" DisplayMemberPath="Display" 
                                  Style="{StaticResource FieldComboBox}"
                                  ToolTip="ArrayOfObjects — [{...},{...}]&#xA;ArrayOfArrays  — [[...],[...]]&#xA;WithHeaders    — {columns:[...],rows:[[...]]}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="NULL как:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{local:EnumValues local:JsonNullMode}" SelectedValue="{Binding Prop_NullMode}" SelectedValuePath="Key" DisplayMemberPath="Display" 
                                  Style="{StaticResource FieldComboBox}"
                                  ToolTip="JsonNull — null&#xA;EmptyString — &quot;&quot;&#xA;Zero — &quot;0&quot;&#xA;Skip — пропустить поле"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Чекбоксы -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox Style="{StaticResource FieldCheckBox}" Grid.Column="0"
                          Content="Форматировать (отступы)"
                          IsChecked="{Binding Prop_Indent}"
                          ToolTip="Форматировать JSON с отступами (human-readable). Увеличивает размер."/>

                <!-- Определять типы — только при JsonToDataTable -->
                <StackPanel Grid.Column="1"
                            Visibility="{Binding Prop_Direction,
                            Converter={StaticResource EnumToVisConverter},
                            ConverterParameter=JsonToDataTable}">
                    <CheckBox Style="{StaticResource FieldCheckBox}" Content="Определять типы колонок"
                              IsChecked="{Binding Prop_TypeInference}"
                              ToolTip="Автоматически определять типы: int, double, bool, DateTime.&#xA;Выключить если нужны все колонки как string."/>
                </StackPanel>
            </Grid>

        </StackPanel>
    </Grid>
</UserControl>
