<UserControl x:Class="Primo.MIA.DataTableJoin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:common="clr-namespace:Primo.MIA"
             mc:Ignorable="d" xmlns:local="clr-namespace:Primo.MIA" d:DesignHeight="300" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/table.png">
            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="DataTable: Соединение ["/>
                <Run Text="{Binding Prop_JoinKind, Mode=OneWay, Converter={StaticResource EnumDisplayNameConverter}}" Foreground="{StaticResource AccentBrush}"/>
                <Run Text="]"/>
            </TextBlock>
            <TextBlock Text="Левая таблица:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_LeftTable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Переменная DataTable"/>
            <TextBlock Text="Правая таблица:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_RightTable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Переменная DataTable"/>
            <TextBlock Text="Ключевые колонки (лево):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_LeftKeys, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Через запятую: Id,Code"/>
            <TextBlock Text="Ключевые колонки (право):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_RightKeys, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Через запятую, по порядку соответствуют левым"/>
            <TextBlock Text="Тип соединения:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{common:EnumValues common:DataTableJoinKind}"
                      SelectedValue="{Binding Prop_JoinKind}"
                      SelectedValuePath="Key"
                      DisplayMemberPath="Display"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Inner — пересечение; Left — все левые; Right — все правые; Full — объединение"/>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Суффикс:" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                <TextBox Grid.Column="1" Text="{Binding Prop_RightSuffix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                         ToolTip="Для конфликтов имён колонок (по умолчанию _right)"/>
            </Grid>
            <CheckBox Style="{StaticResource FieldCheckBox}" Margin="0,6,6,2"
                      Content="Учитывать регистр ключей"
                      IsChecked="{Binding Prop_CaseSensitive}"
                      ToolTip="Для строковых ключей"/>
            <TextBlock Text="Результат (out):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Result, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
    </local:ActivityPanel>
</UserControl>