<!--
    ReadTomlConfig.xaml
    Визуальный интерфейс активности "Чтение TOML конфигурации".

    Особенности:
      - Динамическая видимость блоков в зависимости от выбранного ReadMode:
          SingleValue          → показывает: KeyPath, DefaultValue
          SectionToDictionary  → показывает: SectionName
          FullFileToDictionary → нет доп. полей (только FilePath)
          ReadProfile          → показывает: ProfileName, DefaultProfileName
      - Читаемые лейблы: FontSize=11, жирный, тёмный цвет
      - Поле FilePath снабжено кнопкой "..." для открытия диалога выбора файла
      - Использует универсальные конвертеры из Common/Converters/EnumToVisibilityConverter.cs
      - Использует стили из Common/Styles.xaml
-->
<UserControl x:Class="Primo.MIA.ReadTomlConfig"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="220"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Источник данных для ComboBox режима чтения -->
            <ObjectDataProvider x:Key="ModeValues"
                                MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:TomlReadMode"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <!-- Универсальный конвертер enum → Visibility -->
            <local:EnumToVisibilityConverter x:Key="EnumToVisConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <!-- Колонка для иконки -->
            <ColumnDefinition Width="Auto"/>
            <!-- Колонка для полей -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Иконка активности -->
        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Top"
               Source="pack://application:,,,/Primo.MIA;component/images/config.png"/>

        <!-- Основной блок с полями -->
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Top"
                    Margin="5,2,8,5">

            <!-- ── Заголовок активности с текущим режимом ── -->
            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="Конфиг: Чтение TOML [" Foreground="#FF0E0E0E"/>
                <Run Text="{Binding Path=ReadMode, Mode=OneWay}" Foreground="#FF1565C0"/>
                <Run Text="]" Foreground="#FF0E0E0E"/>
            </TextBlock>

            <!-- ── Режим чтения ── -->
            <TextBlock Text="Режим чтения:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Source={StaticResource ModeValues}}"
                      SelectedItem="{Binding ReadMode}"
                      Style="{StaticResource FieldComboBox}"/>

            <!-- ── Путь к файлу (всегда виден) + кнопка обзора ── -->
            <TextBlock Text="Путь к TOML-файлу:" Style="{StaticResource FieldLabel}"/>
            <!--
                Grid из двух колонок:
                  [0] * — текстовое поле (растягивается)
                  [1] Auto — кнопка "..." фиксированной ширины
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtFilePath"
                         Grid.Column="0"
                         Text="{Binding Prop_FilePath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         Margin="0,0,4,0"
                         ToolTip="Полный путь к файлу конфигурации .toml"/>

                <!-- Кнопка открытия диалога выбора .toml файла -->
                <Button Grid.Column="1"
                        Style="{StaticResource BrowseButton}"
                        Content=""
                        Click="BtnBrowseFile_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="/Primo.MIA;component/images/folder.png" TileMode="None"/>
                    </Button.Background>
                </Button>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════
                 БЛОК: только для режима SingleValue
                 Показывает: KeyPath, DefaultValue
            ═══════════════════════════════════════════════════════ -->
            <StackPanel Visibility="{Binding ReadMode,
                                    Converter={StaticResource EnumToVisConverter},
                                    ConverterParameter=SingleValue}">

                <TextBlock Text="Путь к ключу:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_KeyPath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="Путь к значению через точку: например server.database.host"/>

                <TextBlock Text="Значение по умолчанию:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="Возвращается если ключ не найден (и ThrowIfNotFound = false)"/>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════
                 БЛОК: только для режима SectionToDictionary
                 Показывает: SectionName
            ═══════════════════════════════════════════════════════ -->
            <StackPanel Visibility="{Binding ReadMode,
                                    Converter={StaticResource EnumToVisConverter},
                                    ConverterParameter=SectionToDictionary}">

                <TextBlock Text="Имя секции:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_SectionName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="Имя секции для чтения, поддерживает вложенность: app.database"/>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════
                 БЛОК: только для режима ReadProfile
                 Показывает: ProfileName, DefaultProfileName
            ═══════════════════════════════════════════════════════ -->
            <StackPanel Visibility="{Binding ReadMode,
                                    Converter={StaticResource EnumToVisConverter},
                                    ConverterParameter=ReadProfile}">

                <TextBlock Text="Имя профиля:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_ProfileName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="Имя профиля окружения: production, staging, development и т.д."/>

                <TextBlock Text="Базовая секция:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_DefaultProfileName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="Имя секции-основы для мёржа. Обычно 'default'"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
