<UserControl x:Class="Primo.MIA.UtilitiesClearRunScope"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" xmlns:local="clr-namespace:Primo.MIA"
             d:DesignHeight="80"
             Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/delete.png">
            <TextBlock Text="Утилиты: Очистка состояния прогона" Style="{StaticResource ActivityHeader}"/>
            <TextBlock Style="{StaticResource DangerHint}"
                       Text="⚠ Закрывает сессии браузера и сбрасывает ambient-контекст прогона"/>
            <TextBlock Text="Закрывает браузерные сессии (Quit) и очищает пользовательские данные RepoDict —"
                       Style="{StaticResource HintText}"/>
            <TextBlock Text="вызывайте в конце прогона робота, чтобы данные не утекали между запусками в разделяемом процессе Studio."
                       Style="{StaticResource HintText}"/>
    </local:ActivityPanel>
</UserControl>
