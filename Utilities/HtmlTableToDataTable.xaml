<UserControl x:Class="Primo.MIA.HtmlTableToDataTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:common="clr-namespace:Primo.MIA"
             mc:Ignorable="d" d:DesignHeight="220" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="32" Height="32" Margin="5" VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/table.png"/>
        <StackPanel Grid.Column="1" Margin="5,0,5,5">
            <TextBlock Text="HTML: Таблица → DataTable" Style="{StaticResource ActivityHeader}"/>
            <TextBlock Text="HTML:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Html, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="72"
                     ToolTip="Документ или фрагмент с таблицей (&lt;table&gt;).&#xA;Поддерживаются rowspan/colspan; вложенные таблицы игнорируются"/>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Индекс таблицы:" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                <TextBox Grid.Column="1" Text="{Binding Prop_TableIndex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                         ToolTip="Если таблиц несколько (0 = первая)"/>
            </Grid>
            <CheckBox Style="{StaticResource FieldCheckBox}" Margin="0,6,6,2"
                      Content="Первая строка — заголовки"
                      IsChecked="{Binding Prop_HeaderRow}"
                      ToolTip="Имена колонок из первой строки; иначе Column1..N"/>
            <TextBlock Text="DataTable (out):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Result, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
        </StackPanel>
    </Grid>
</UserControl>
