<!--
    DataTableToHtml.xaml
    Визуальный интерфейс активности "DataTable в HTML".
    
    Функции:
      - Конвертация DataTable в HTML таблицу
      - Выбор темы оформления
      - Настройка параметров вывода
-->
<UserControl x:Class="Primo.MIA.DataTableToHtml"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="120"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/table.png"/>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Top"
                    Margin="5,0,5,5">

            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="DataTable в HTML ["/>
                <Run Text="{Binding Prop_Theme, Mode=OneWay, Converter={StaticResource EnumDisplayNameConverter}}" Foreground="{StaticResource AccentBrush}"/>
                <Run Text="]"/>
            </TextBlock>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="Тема:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{local:EnumValues local:HtmlTableTheme}" SelectedValue="{Binding Prop_Theme}" SelectedValuePath="Key" DisplayMemberPath="Display" 
                              Style="{StaticResource FieldComboBox}"
                              ToolTip="Предустановленная тема оформления таблицы"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    <TextBlock Text="Режим вывода:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{local:EnumValues local:HtmlOutputMode}" SelectedValue="{Binding Prop_OutputMode}" SelectedValuePath="Key" DisplayMemberPath="Display" 
                              Style="{StaticResource FieldComboBox}"
                              ToolTip="Только таблица или полный HTML-документ"/>
                </StackPanel>
            </Grid>

            <CheckBox Style="{StaticResource FieldCheckBox}" Content="Нумерация строк"
                      IsChecked="{Binding Prop_ShowRowNumbers}"
                      Margin="0,4,0,2"
                      ToolTip="Добавить колонку с порядковыми номерами строк"/>

        </StackPanel>
    </Grid>
</UserControl>
