<UserControl x:Class="Primo.MIA.DataTableToCsv"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="240" Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/table.png"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="5,0,5,5">

            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="DataTable → CSV"/>
            </TextBlock>

            <!-- Входная таблица -->
            <TextBlock Text="DataTable (входная):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Table, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Переменная DataTable для конвертации в CSV"/>

            <!-- Приёмник -->
            <TextBlock Text="Приёмник:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{local:EnumValues local:CsvLocation}"
                      SelectedValue="{Binding Prop_Target}"
                      SelectedValuePath="Key"
                      DisplayMemberPath="Display"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Строка — CSV-текст в выходную переменную;&#xA;Файл — запись на диск"/>

            <!-- Файл — только режим Файл -->
            <StackPanel Visibility="{Binding Prop_Target,
                                    Converter={StaticResource EnumToVisConverter},
                                    ConverterParameter=File}">
                <TextBlock Text="Путь к файлу:" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtFilePath"
                             Grid.Column="0"
                             Text="{Binding Prop_FilePath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldBox}"
                             Margin="0,2,4,0"
                             ToolTip="Путь к создаваемому CSV-файлу (папка создаётся при отсутствии)"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource BrowseButton}"
                            Content=""
                            Click="BtnBrowseCsv_Click"
                            ToolTip="Указать файл...">
                        <Button.Background>
                            <ImageBrush ImageSource="/Primo.MIA;component/images/folder.png" TileMode="None"/>
                        </Button.Background>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Настройки -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Разделитель:" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                <TextBox Grid.Column="1" Text="{Binding Prop_Delimiter, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="',' (по умолчанию), ';', '|', таб"/>
            </Grid>
            <Grid Margin="0,2,0,0"
                  Visibility="{Binding Prop_Target,
                               Converter={StaticResource EnumToVisConverter},
                               ConverterParameter=File}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Кодировка:" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                <TextBox Grid.Column="1" Text="{Binding Prop_Encoding, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="utf-8 без BOM (по умолчанию), windows-1251"/>
            </Grid>

            <!-- Чекбоксы -->
            <CheckBox Style="{StaticResource FieldCheckBox}" Margin="0,6,6,2"
                      Content="Заголовки колонок"
                      IsChecked="{Binding Prop_IncludeHeader}"
                      ToolTip="Первая строка CSV — имена колонок"/>
            <CheckBox Style="{StaticResource FieldCheckBox}"
                      Content="DBNull как пустое поле"
                      IsChecked="{Binding Prop_DBNullToEmpty}"
                      ToolTip="NULL-значения записываются пустыми"/>

            <!-- Выходные -->
            <Grid Margin="0,4,0,0"
                  Visibility="{Binding Prop_Target,
                               Converter={StaticResource EnumToVisConverter},
                               ConverterParameter=String}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="CSV (out): " VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                <TextBox Grid.Column="1" Text="{Binding Prop_Result, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            </Grid>

        </StackPanel>
    </Grid>
</UserControl>
