<UserControl x:Class="Primo.MIA.EmlParse"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" xmlns:local="clr-namespace:Primo.MIA" d:DesignHeight="220" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/http.png">
            <TextBlock Text="Почта: Разобрать EML" Style="{StaticResource ActivityHeader}"/>

            <TextBlock Text="Путь к EML:" Style="{StaticResource FieldLabel}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtEmlPath"
                         Grid.Column="0"
                         Text="{Binding Prop_EmlPath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         Margin="0,2,4,0"
                         ToolTip="Файл .eml, например C:\входящие\письмо.eml"/>
                <Button Grid.Column="1"
                        Style="{StaticResource BrowseButton}"
                        Content=""
                        Click="BtnBrowseEml_Click"
                        ToolTip="Выбрать EML-файл...">
                    <Button.Background>
                        <ImageBrush ImageSource="/Primo.MIA;component/images/folder.png" TileMode="None"/>
                    </Button.Background>
                </Button>
            </Grid>
            <TextBlock Text="Вложения → папка:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_AttachmentsDir, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Пусто — не сохранять"/>
            <TextBlock Text="Тело → файл:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_BodyToFile, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Пусто — не сохранять (UTF-8)"/>
    </local:ActivityPanel>
</UserControl>
