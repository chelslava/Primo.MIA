<!--
    ElementDragDrop.xaml
    Визуальный интерфейс активности "Перетаскивание элемента".

    Функции:
      - Drag & Drop элемента из одной позиции в другую
      - Поддержка различных типов локаторов
-->
<UserControl x:Class="Primo.MIA.ElementDragDrop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="180"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="LocatorTypeValues"
                                MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:ElementLocatorType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/browser.png"/>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Top"
                    Margin="5,0,5,5">

            <TextBlock Style="{StaticResource ActivityHeader}"
                       Text="Перетаскивание элемента"/>

            <!-- Исходный элемент -->
            <TextBlock Text="Исходный элемент"
                       Style="{StaticResource SectionHeader}"/>

            <TextBlock Text="Тип локатора:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Source={StaticResource LocatorTypeValues}}"
                      SelectedItem="{Binding Prop_SourceLocatorType}"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Тип локатора для поиска исходного элемента"/>

            <TextBlock Text="Значение локатора:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_SourceLocatorValue, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Значение локатора для исходного элемента"/>

            <!-- Целевой элемент -->
            <TextBlock Text="Целевой элемент"
                       Style="{StaticResource SectionHeader}"/>

            <TextBlock Text="Тип локатора:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Source={StaticResource LocatorTypeValues}}"
                      SelectedItem="{Binding Prop_TargetLocatorType}"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Тип локатора для поиска целевого элемента"/>

            <TextBlock Text="Значение локатора:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_TargetLocatorValue, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Значение локатора для целевого элемента"/>

            <TextBlock Text="ID сессии браузера:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_SessionId, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="ID сессии браузера (оставьте пустым для использования текущей)"/>

        </StackPanel>
    </Grid>
</UserControl>
