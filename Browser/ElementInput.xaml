<!--
    ElementInput.xaml
    Визуальный интерфейс активности "Ввод в элемент".

    Режимы:
      Text       — ввод текста
      SpecialKey — нажатие специальной клавиши
-->
<UserControl x:Class="Primo.MIA.ElementInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="80"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="LocatorTypeValues"
                                MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:ElementLocatorType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="InputModeValues"
                                MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:InputMode"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="SpecialKeyValues"
                                MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:SpecialKeyType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <local:EnumToVisibilityConverter x:Key="EnumToVisConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/browser.png"/>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Top"
                    Margin="5,0,5,5">

            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="Элемент: Ввод [" Foreground="#FF0E0E0E"/>
                <Run Text="{Binding Path=Prop_InputMode, Mode=OneWay}" Foreground="#FF1565C0"/>
                <Run Text="]" Foreground="#FF0E0E0E"/>
            </TextBlock>

            <TextBlock Text="Режим ввода:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Source={StaticResource InputModeValues}}"
                      SelectedItem="{Binding Prop_InputMode}"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Выберите режим: ввод текста или специальная клавиша"/>

            <TextBlock Text="Тип локатора:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Source={StaticResource LocatorTypeValues}}"
                      SelectedItem="{Binding Prop_LocatorType}"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Тип локатора для поиска элемента (CSS, XPath, ID и т.д.)"/>

            <TextBlock Text="Значение локатора:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_LocatorValue, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Значение локатора: CSS-селектор, XPath-выражение, ID элемента и т.д."/>

            <!-- Блок для режима Text -->
            <StackPanel Visibility="{Binding Prop_InputMode,
                                    Converter={StaticResource EnumToVisConverter},
                                    ConverterParameter=Text}">
                <TextBlock Text="Текст для ввода:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_Text, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="Текст для ввода в элемент"/>
            </StackPanel>

            <!-- Блок для режима SpecialKey -->
            <StackPanel Visibility="{Binding Prop_InputMode,
                                    Converter={StaticResource EnumToVisConverter},
                                    ConverterParameter=SpecialKey}">
                <TextBlock Text="Специальная клавиша:" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Source={StaticResource SpecialKeyValues}}"
                          SelectedItem="{Binding Prop_SpecialKey}"
                          Style="{StaticResource FieldComboBox}"
                          ToolTip="Выберите специальную клавишу (Enter, Tab, Escape и т.д.)"/>
            </StackPanel>

            <TextBlock Text="ID сессии браузера:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_SessionId, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="ID сессии браузера (оставьте пустым для использования текущей)"/>

        </StackPanel>
    </Grid>
</UserControl>
