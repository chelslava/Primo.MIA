<UserControl x:Class="Primo.MIA.BrowserScreenshot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="70"
             Margin="0,0,0,5">
    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Top"
               Source="pack://application:,,,/Primo.MIA;component/images/browser.png"/>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Top"
                    Margin="5,0,5,5">

            <TextBlock Text="Скриншот страницы"
                       FontWeight="Bold" FontSize="12"
                       Foreground="#FF0E0E0E"
                       Height="18" Margin="0,2,0,2"/>

            <!-- Строка выбора файла: TextBox + кнопка обзора -->
            <Grid Margin="0,2,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Путь к файлу -->
                <TextBox Grid.Column="0"
                         Text="{Binding Prop_FilePath, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="False"
                         BorderThickness="1"
                         BorderBrush="#D0D7E2"
                         TextWrapping="NoWrap"
                         Height="22"
                         VerticalContentAlignment="Center"/>

                <!-- Кнопка открытия диалога выбора файла -->
                <Button Grid.Column="1"
                        Content=""
                        Width="26" Height="22"
                        Margin="2,0,0,0"
                        Click="BrowseFile_Click">
                    <Button.Background>
                        <ImageBrush TileMode="Tile" ImageSource="/Primo.MIA;component/images/folder.png"/>
                    </Button.Background>
                </Button>
            </Grid>

        </StackPanel>
    </Grid>
</UserControl>