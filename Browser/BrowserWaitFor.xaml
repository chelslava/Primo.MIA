<!--
    BrowserWaitFor.xaml
    Визуальный интерфейс активности "Ожидание условия браузера".

    Режимы:
      PageLoad       — ожидание загрузки страницы
      ElementExists  — ожидание появления элемента
      ElementVisible — ожидание видимости элемента
      ElementClickable — ожидание кликабельности элемента
      ElementHidden  — ожидание исчезновения элемента
      TitleContains  — ожидание заголовка
      UrlContains    — ожидание URL

    Условная видимость полей:
      - Поля локатора: для ElementExists, ElementVisible, ElementClickable, ElementHidden
      - Поля текста: для TitleContains, UrlContains
-->
<UserControl x:Class="Primo.MIA.BrowserWaitFor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="80"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="ConditionTypeValues"
                                MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:WaitConditionType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="LocatorTypeValues"
                                MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:ElementLocatorType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <!-- Конвертеры для условной видимости -->
            <local:EnumToVisibilityConverter x:Key="EnumToVisConverter"/>
            <local:MultiEnumToVisibilityConverter x:Key="MultiEnumToVisConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/browser.png"/>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Top"
                    Margin="5,0,5,5">

            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="Ожидание условия [" Foreground="#FF0E0E0E"/>
                <Run Text="{Binding Path=Prop_Condition, Mode=OneWay}" Foreground="#FF1565C0"/>
                <Run Text="]" Foreground="#FF0E0E0E"/>
            </TextBlock>

            <TextBlock Text="Условие ожидания:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Source={StaticResource ConditionTypeValues}}"
                      SelectedItem="{Binding Prop_Condition}"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Выберите условие для ожидания"/>

            <TextBlock Text="ID сессии браузера:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_SessionId, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="ID сессии браузера (оставьте пустым для использования текущей)"/>

            <TextBlock Text="Таймаут (сек):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Timeout, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Максимальное время ожидания в секундах"/>

            <!-- Блок для условий с элементом: ElementExists, ElementVisible, ElementClickable, ElementHidden -->
            <StackPanel Visibility="{Binding Path=Prop_Condition, Converter={StaticResource MultiEnumToVisConverter}, ConverterParameter=ElementExists|ElementVisible|ElementClickable|ElementHidden}">
                <TextBlock Text="Тип локатора:" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Source={StaticResource LocatorTypeValues}}"
                          SelectedItem="{Binding Prop_LocatorType}"
                          Style="{StaticResource FieldComboBox}"
                          ToolTip="Тип локатора для поиска элемента"/>

                <TextBlock Text="Значение локатора:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_LocatorValue, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="Значение локатора: CSS-селектор, XPath-выражение, ID элемента и т.д."/>
            </StackPanel>

            <!-- Блок для условий с текстом: TitleContains, UrlContains -->
            <StackPanel Visibility="{Binding Path=Prop_Condition, Converter={StaticResource MultiEnumToVisConverter}, ConverterParameter=TitleContains|UrlContains}">
                <TextBlock Text="Ожидаемый текст:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_ExpectedText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="Текст, который должен содержаться в заголовке или URL"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
