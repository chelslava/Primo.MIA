<UserControl x:Class="Primo.MIA.BrowserOpen"
             xmlns:WFItems="clr-namespace:LTools.Common.WFItems;assembly=LTools.Common"
             xmlns:ui="clr-namespace:LTools.Common.UIElements;assembly=LTools.Common"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="BrowserTypeValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:BrowserType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Тип браузера" HorizontalAlignment="Left" Margin="5,0,0,0" Foreground="#FF0E0E0E"/>

        <ComboBox Grid.Row="1" 
                  ItemsSource="{Binding Source={StaticResource BrowserTypeValues}}"
                  SelectedItem="{Binding Prop_BrowserType}"
                  Margin="5,0,5,0" 
                  Height="23" />

        <Grid Grid.Row="2">
            <Grid Grid.Column="0" Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid Grid.Row="1" Margin="5">
                    <Border BorderThickness="1" 
                            CornerRadius="0,0,0,0" 
                            Padding="{x:Static ui:WFElementBase.ContainerPadding}" Background="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}">
                        <WFItems:WFContainerBase x:Name="cntBrowser" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
