<!--
    BrowserOpen.xaml
    Визуальный интерфейс активности "Открытие браузера".

    Особенности:
      - Выбор типа браузера (Chrome, Firefox, Edge, Safari)
      - Контейнер для дополнительных настроек
-->
<UserControl x:Class="Primo.MIA.BrowserOpen"
             xmlns:WFItems="clr-namespace:LTools.Common.WFItems;assembly=LTools.Common"
             xmlns:ui="clr-namespace:LTools.Common.UIElements;assembly=LTools.Common"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/browser.png">

            <TextBlock Text="Браузер: Открыть сессию" Style="{StaticResource ActivityHeader}"/>

            <TextBlock Text="Тип браузера:" Style="{StaticResource FieldLabel}"/>

            <ComboBox ItemsSource="{local:EnumValues local:BrowserType}" SelectedValue="{Binding Prop_BrowserType}" SelectedValuePath="Key" DisplayMemberPath="Display"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Выберите тип браузера для запуска (Chrome, Firefox, Edge, Safari)"/>

            <!-- Контейнер дочерних активностей (элементы внутри сессии браузера) -->
            <Grid Margin="0,10,0,0">
                <Border BorderThickness="1"
                        CornerRadius="0,0,0,0"
                        Padding="{x:Static ui:WFElementBase.ContainerPadding}"
                        Background="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}">
                    <WFItems:WFContainerBase x:Name="cntBrowser" />
                </Border>
            </Grid>
    </local:ActivityPanel>
</UserControl>
