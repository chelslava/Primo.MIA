<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             x:Class="Primo.MIA.BrowserManageCookies"
             d:DesignHeight="80"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/browser.png">

            <TextBlock Style="{StaticResource ActivityHeader}">
                       <Run Text="Управление cookies ["/>
                       <Run Text="{Binding Path=Prop_Operation, Mode=OneWay, Converter={StaticResource EnumDisplayNameConverter}}" Foreground="{StaticResource AccentBrush}"/>
                       <Run Text="]"/>
            </TextBlock>

            <ComboBox ItemsSource="{local:EnumValues local:CookieOperation}" SelectedValue="{Binding Prop_Operation}" SelectedValuePath="Key" DisplayMemberPath="Display" 
                      Style="{StaticResource FieldComboBox}"/>
    </local:ActivityPanel>
</UserControl>
