<!--
    BrowserNavigate.xaml
    Визуальный интерфейс активности "Навигация браузера".

    Режимы:
      Url     — перейти по URL
      Back    — назад в истории
      Forward — вперёд в истории
      Refresh — обновить страницу
-->
<UserControl x:Class="Primo.MIA.BrowserNavigate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="80"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/browser.png"/>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Top"
                    Margin="5,0,5,5">

            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="Навигация ["/>
                <Run Text="{Binding Path=Prop_Mode, Mode=OneWay, Converter={StaticResource EnumDisplayNameConverter}}" Foreground="{StaticResource AccentBrush}"/>
                <Run Text="]"/>
            </TextBlock>

            <TextBlock Text="Режим навигации:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{local:EnumValues local:NavigateMode}" SelectedValue="{Binding Prop_Mode}" SelectedValuePath="Key" DisplayMemberPath="Display" 
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Выберите действие навигации"/>

            <!-- Блок для режима Url -->
            <StackPanel Visibility="{Binding Prop_Mode,
                                    Converter={StaticResource EnumToVisConverter},
                                    ConverterParameter=Url}">
                <TextBlock Text="URL:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_Url, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="URL-адрес для перехода (например, https://example.com)"/>
            </StackPanel>

            <TextBlock Text="ID сессии браузера:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_SessionId, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="ID сессии браузера (оставьте пустым для использования текущей)"/>

        </StackPanel>
    </Grid>
</UserControl>
