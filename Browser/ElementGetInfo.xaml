<!--
    ElementGetInfo.xaml
    Визуальный интерфейс активности "Получение информации об элементе".

    Режимы:
      Text       — получить текст элемента
      Attribute  — получить значение атрибута
      TagName    — получить имя тега
      IsVisible  — проверить видимость
      IsEnabled  — проверить доступность
-->
<UserControl x:Class="Primo.MIA.ElementGetInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="80"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="LocatorTypeValues"
                                MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:ElementLocatorType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="InfoModeValues"
                                MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:ElementInfoMode"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <local:EnumToVisibilityConverter x:Key="EnumToVisConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/browser.png"/>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Top"
                    Margin="5,0,5,5">

            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="Элемент: Получить информацию [" Foreground="#FF0E0E0E"/>
                <Run Text="{Binding Path=Prop_Mode, Mode=OneWay}" Foreground="#FF1565C0"/>
                <Run Text="]" Foreground="#FF0E0E0E"/>
            </TextBlock>

            <TextBlock Text="Режим получения:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Source={StaticResource InfoModeValues}}"
                      SelectedItem="{Binding Prop_Mode}"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Выберите тип информации для получения"/>

            <TextBlock Text="Тип локатора:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Source={StaticResource LocatorTypeValues}}"
                      SelectedItem="{Binding Prop_LocatorType}"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Тип локатора для поиска элемента (CSS, XPath, ID и т.д.)"/>

            <TextBlock Text="Значение локатора:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_LocatorValue, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Значение локатора: CSS-селектор, XPath-выражение, ID элемента и т.д."/>

            <!-- Блок для режима Attribute -->
            <StackPanel Visibility="{Binding Prop_Mode,
                                    Converter={StaticResource EnumToVisConverter},
                                    ConverterParameter=Attribute}">
                <TextBlock Text="Имя атрибута:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_AttributeName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="Имя атрибута для получения значения (например: href, class, id)"/>
            </StackPanel>

            <TextBlock Text="ID сессии браузера:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_SessionId, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="ID сессии браузера (оставьте пустым для использования текущей)"/>

            <TextBlock Text="Переменная-результат:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ResultVariable, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Имя переменной для сохранения полученного значения"/>

        </StackPanel>
    </Grid>
</UserControl>
