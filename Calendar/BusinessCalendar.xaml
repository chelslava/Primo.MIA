<!--
    BusinessCalendar.xaml
    Визуальный интерфейс активности "Работа с производственным календарём".

    Режимы:
      AddWorkDays      — добавить рабочие дни к дате
      SubtractWorkDays — вычесть рабочие дни из даты
      CheckDayType     — проверить тип дня (рабочий/выходной/праздник)
      CountWorkdays    — подсчитать рабочие дни между двумя датами  [П2]
      NextWorkday      — найти следующий рабочий день               [П3]
      PrevWorkday      — найти предыдущий рабочий день              [П3]

    ИЗМЕНЕНИЯ:
      [FIX-5] Удалён мёртвый ресурс RegionValues.
      [П2]    Добавлен блок «Конечная дата» — виден только в режиме CountWorkdays.
      [П3]    Режимы NextWorkday и PrevWorkday отображаются в ComboBox автоматически
              через ObjectDataProvider для обновлённого BusinessCalendarMode.
-->
<UserControl x:Class="Primo.MIA.BusinessCalendar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="160"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Все значения BusinessCalendarMode (включая новые CountWorkdays, NextWorkday, PrevWorkday) -->
            <ObjectDataProvider x:Key="ModeValues"
                                MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:BusinessCalendarMode"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <!--
                Конвертер: скрывает/показывает блок по одному значению enum.
                Используется для блоков DaysCount и EndDate.
            -->
            <local:EnumToVisibilityConverter      x:Key="EnumToVisConverter"/>

            <!--
                Конвертер: показывает блок если значение соответствует ОДНОМУ из перечисленных.
                Используется для блока DaysCount (AddWorkDays | SubtractWorkDays).
            -->
            <local:MultiEnumToVisibilityConverter x:Key="MultiEnumToVisConverter"/>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Иконка активности -->
        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/calendar.png"/>

        <!-- Поля активности -->
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Top"
                    Margin="5,0,5,5">

            <!-- Заголовок с отображением текущего режима -->
            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="Календарь: Операции [" Foreground="#FF0E0E0E"/>
                <Run Text="{Binding Prop_OperationMode, Mode=OneWay}" Foreground="#FF1565C0"/>
                <Run Text="]" Foreground="#FF0E0E0E"/>
            </TextBlock>

            <!-- ID календаря (GUID от CalendarLoad) -->
            <TextBlock Text="ID календаря:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_CalendarId, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="GUID календаря из активности «Календарь: Загрузить»"/>

            <!-- Режим операции -->
            <TextBlock Text="Режим операции:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Source={StaticResource ModeValues}}"
                      SelectedItem="{Binding Prop_OperationMode}"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Выберите операцию с производственным календарём"/>

            <!-- Входная дата -->
            <TextBlock Text="Входная дата:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_InputDate, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Дата для операции (начальная дата для режима CountWorkdays)"/>

            <!--
                [П2] Блок «Конечная дата» — виден только в режиме CountWorkdays.
                Используем EnumToVisConverter с одним значением.
            -->
            <StackPanel Visibility="{Binding Prop_OperationMode,
                                    Converter={StaticResource EnumToVisConverter},
                                    ConverterParameter=CountWorkdays}">
                <TextBlock Text="Конечная дата:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_EndDate, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="Конечная дата диапазона для подсчёта рабочих дней"/>
            </StackPanel>

            <!--
                Блок «Количество дней» — виден только для AddWorkDays и SubtractWorkDays.
                NextWorkday и PrevWorkday не требуют количества дней.
            -->
            <StackPanel Visibility="{Binding Prop_OperationMode,
                                    Converter={StaticResource MultiEnumToVisConverter},
                                    ConverterParameter=AddWorkDays|SubtractWorkDays}">
                <TextBlock Text="Количество дней:" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Prop_DaysCount, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="Количество рабочих дней для прибавления/вычитания"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
