<UserControl x:Class="Primo.MIA.JsonSchemaValidate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:common="clr-namespace:Primo.MIA"
             mc:Ignorable="d" xmlns:local="clr-namespace:Primo.MIA" d:DesignHeight="280" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/json.png">
            <TextBlock Text="JSON: Валидация по схеме" Style="{StaticResource ActivityHeader}"/>
            <TextBlock Text="JSON:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Json, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="52"
                     ToolTip="Проверяемый JSON (ответ API, payload вебхука)"/>
            <TextBlock Text="JSON Schema:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Schema, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="52"
                     ToolTip="Схема документа (draft-07 подмножество). Сгенерировать из примера — активность «JSON: Схема из примера»"/>
            <TextBlock Text="Валиден (out):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_IsValid, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            <TextBlock Text="Ошибок (out):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ErrorCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            <TextBlock Text="Ошибки (out):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Errors, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="DataTable: path (путь в данных), error (вид нарушения)"/>
    </local:ActivityPanel>
</UserControl>