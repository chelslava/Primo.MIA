<UserControl x:Class="Primo.MIA.JsonSchemaGenerate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:common="clr-namespace:Primo.MIA"
             mc:Ignorable="d" xmlns:local="clr-namespace:Primo.MIA" d:DesignHeight="240" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/json.png">
            <TextBlock Text="JSON: Схема из примера" Style="{StaticResource ActivityHeader}"/>
            <TextBlock Text="Пример JSON:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_SampleJson, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="52"
                     ToolTip="Валидный JSON-документ — по нему строится схема"/>
            <TextBlock Text="Заголовок (title):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Заголовок схемы; пусто — без заголовка"/>
            <CheckBox Style="{StaticResource FieldCheckBox}" Margin="0,6,6,2"
                      Content="Форматировать (отступы)"
                      IsChecked="{Binding Prop_PrettyPrint}"/>
            <TextBlock Text="Schema (out):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Result, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="52"
                     ToolTip="Сгенерированная JSON Schema. Проверьте required/minLength — генератор выводит типы и структуру, но не бизнес-правила"/>
    </local:ActivityPanel>
</UserControl>