<UserControl x:Class="Primo.MIA.JsonQuery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="100" Margin="0,0,0,5">

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Иконка -->
        <Image Grid.Column="0"
               Width="32" Height="32"
               Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/http.png"/>

        <!-- Содержимое -->
        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="5,0,5,5">

            <!-- Заголовок -->
            <TextBlock FontWeight="Bold" FontSize="12" Foreground="#FF0E0E0E">
                <Run Text="JSON: Запрос (JSONPath)"/>
            </TextBlock>

            <!-- JSONPath -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Путь: " VerticalAlignment="Center" FontSize="11" Foreground="#FF0E0E0E"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Prop_JsonPath, UpdateSourceTrigger=PropertyChanged}"
                         Height="20"
                         Margin="0,0,6,0"
                         BorderThickness="0"
                          />
            </Grid>

            <!-- Опции -->
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <CheckBox Content="Только первое совпадение"
                          IsChecked="{Binding Prop_ReturnFirst}"
                          FontSize="10"
                          VerticalAlignment="Center" Foreground="#FF0E0E0E"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
