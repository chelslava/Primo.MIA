<UserControl x:Class="Primo.MIA.JsonQuery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" xmlns:local="clr-namespace:Primo.MIA"
             d:DesignHeight="100" Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/json.png">

            <!-- Заголовок -->
            <TextBlock Style="{StaticResource ActivityHeader}">
                <Run Text="JSON: Запрос (JSONPath)"/>
            </TextBlock>

            <!-- JSONPath -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Путь: " VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Prop_JsonPath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldBox}"
                         ToolTip="JSONPath-выражение, например $.store.book[0].title или $..author"/>
            </Grid>

            <!-- Опции -->
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <CheckBox Style="{StaticResource FieldCheckBox}" Content="Только первое совпадение"
                          IsChecked="{Binding Prop_ReturnFirst}"
                          ToolTip="Вернуть первое совпадение вместо списка всех совпадений"/>
            </StackPanel>
    </local:ActivityPanel>
</UserControl>
