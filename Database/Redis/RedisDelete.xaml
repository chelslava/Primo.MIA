<UserControl x:Class="Primo.MIA.RedisDelete"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" xmlns:local="clr-namespace:Primo.MIA" d:DesignHeight="200" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/bd.png">
            <TextBlock Text="Redis: Удалить ключ" Style="{StaticResource ActivityHeader}"/>
            <TextBlock Style="{StaticResource DangerHint}"
                       Text="⚠ Необратимо: ключи удаляются из Redis (DEL)"/>
            <TextBlock Text="Строка подключения:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ConnectionString, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Строка подключения StackExchange.Redis (например localhost:6379)"/>
            <TextBlock Text="Ключи (List&lt;string&gt;):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Keys, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Переменная (список строк) с ключами Redis для удаления (DEL)"/>
            <TextBlock Text="Удалено ключей:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_DeletedCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Переменная (Int64) для количества удалённых ключей"/>
    </local:ActivityPanel>
</UserControl>
