<UserControl x:Class="Primo.MIA.RedisHashGet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" xmlns:local="clr-namespace:Primo.MIA" d:DesignHeight="240" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/bd.png">
            <TextBlock Text="Redis: Получить поле хэша" Style="{StaticResource ActivityHeader}"/>
            <TextBlock Text="Строка подключения:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ConnectionString, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Строка подключения StackExchange.Redis (например localhost:6379)"/>
            <TextBlock Text="Ключ:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Key, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Ключ хэша Redis (HGET/HGETALL)"/>
            <TextBlock Text="Поле (пусто = все поля):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Field, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Поле хэша для чтения; пусто — прочитать все поля (HGETALL)"/>
            <TextBlock Text="Значение поля:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_FieldValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Переменная (String) для значения указанного поля"/>
            <TextBlock Text="Все поля (Dictionary):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_AllFields, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Переменная (словарь) со всеми полями хэша"/>
    </local:ActivityPanel>
</UserControl>
