<UserControl x:Class="Primo.MIA.DatabaseTransactionCommit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" xmlns:local="clr-namespace:Primo.MIA"
             d:DesignHeight="80"
             Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/bd.png">
            <TextBlock Text="БД: Подтвердить транзакцию" Style="{StaticResource ActivityHeader}"/>
            <TextBlock Text="TransactionId (необязательно):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_TransactionId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Идентификатор транзакции из «БД: Начать транзакцию»; пусто — зафиксировать единственную открытую"/>
    </local:ActivityPanel>
</UserControl>
