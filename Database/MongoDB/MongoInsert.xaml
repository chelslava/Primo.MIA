<UserControl x:Class="Primo.MIA.MongoInsert"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="270" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="32" Height="32" Margin="5" VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/bd.png"/>
        <StackPanel Grid.Column="1" Margin="5,0,5,5">
            <TextBlock Text="MongoDB: Вставить документ" Style="{StaticResource FieldLabel}"/>
            <TextBlock Text="Строка подключения:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ConnectionString, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Строка подключения MongoDB (например mongodb://localhost:27017)"/>
            <TextBlock Text="База данных:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Database, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Имя базы данных MongoDB"/>
            <TextBlock Text="Коллекция:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Collection, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Имя коллекции для вставки документа"/>
            <TextBlock Text="Документ (JSON):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Document, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Вставляемый документ в формате JSON, например {&quot;name&quot;: &quot;Иван&quot;, &quot;age&quot;: 30}"/>
            <TextBlock Text="Вставлено документов:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_InsertedCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Переменная (Int64) для количества вставленных документов"/>
        </StackPanel>
    </Grid>
</UserControl>
