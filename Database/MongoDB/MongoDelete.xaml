<UserControl x:Class="Primo.MIA.MongoDelete"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" xmlns:local="clr-namespace:Primo.MIA" d:DesignHeight="260" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/bd.png">
            <TextBlock Text="MongoDB: Удалить документы" Style="{StaticResource ActivityHeader}"/>
            <TextBlock Style="{StaticResource DangerHint}"
                       Text="⚠ Необратимо: документы удаляются из коллекции"/>
            <TextBlock Text="Строка подключения:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ConnectionString, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Строка подключения MongoDB (например mongodb://localhost:27017)"/>
            <TextBlock Text="База данных:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Database, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Имя базы данных MongoDB"/>
            <TextBlock Text="Коллекция:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Collection, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Имя коллекции для удаления документов"/>
            <TextBlock Text="Фильтр (JSON):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Filter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Обязательный фильтр удаляемых документов, например {&quot;status&quot;: &quot;obsolete&quot;}"/>
            <TextBlock Text="Удалено документов:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_DeletedCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Переменная (Int64) для количества удалённых документов"/>
    </local:ActivityPanel>
</UserControl>
