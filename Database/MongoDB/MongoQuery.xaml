<UserControl x:Class="Primo.MIA.MongoQuery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" xmlns:local="clr-namespace:Primo.MIA" d:DesignHeight="320" Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/bd.png">
            <TextBlock Text="MongoDB: Запрос" Style="{StaticResource ActivityHeader}"/>
            <TextBlock Text="Строка подключения:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ConnectionString, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Строка подключения MongoDB (например mongodb://localhost:27017)"/>
            <TextBlock Text="База данных:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Database, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Имя базы данных MongoDB"/>
            <TextBlock Text="Коллекция:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Collection, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Имя коллекции MongoDB"/>
            <TextBlock Text="Фильтр (JSON):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Filter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Фильтр документов в формате JSON, например {&quot;age&quot;: {&quot;$gte&quot;: 18}}; пусто — все документы"/>
            <TextBlock Text="Результат (JSON):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ResultJson, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Переменная (JSON-строка) с найденными документами"/>
            <TextBlock Text="Кол-во документов:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Count, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Переменная (Int64) для количества найденных документов"/>
    </local:ActivityPanel>
</UserControl>
