<UserControl x:Class="Primo.MIA.DatabaseBulkInsert"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="80"
             Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/bd.png"/>

        <StackPanel Grid.Column="1" Margin="5,0,5,5">
            <TextBlock Text="БД: Массовая запись из DataTable" Style="{StaticResource ActivityHeader}"/>

            <TextBlock Text="Таблица данных (DataTable):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_DataTable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Переменная (DataTable) с данными для записи в БД"/>

            <TextBlock Text="Поставщик (invariant name):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ProviderInvariantName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Поставщик ADO.NET (invariant name): System.Data.SqlClient (по умолчанию), Npgsql, MySql.Data.MySqlClient и т.п."/>

            <TextBlock Text="Строка подключения:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ConnectionString, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Строка подключения ADO.NET (формат зависит от провайдера)"/>

            <TextBlock Text="TransactionId (необязательно):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_TransactionId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Идентификатор транзакции из «БД: Начать транзакцию»; пусто — выполнить вне транзакции"/>

            <TextBlock Text="Таблица-приёмник:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_DestinationTable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Имя целевой таблицы БД для массовой записи"/>

            <TextBlock Text="Соответствие колонок (Dictionary&lt;string,string&gt;):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ColumnMappings, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Соответствие «колонка DataTable → колонка таблицы БД»; пусто — сопоставление по именам"/>

            <TextBlock Text="Размер пакета:" Style="{StaticResource FieldLabel}"/>
            <TextBox Style="{StaticResource ValidatingFieldBox}"
                     ToolTip="Размер пакета массовой записи, строк (по умолчанию 1000)">
                <TextBox.Text>
                    <Binding Path="Prop_BatchSize" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <local:NumericValidationRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <TextBlock Text="Таймаут (сек):" Style="{StaticResource FieldLabel}"/>
            <TextBox Style="{StaticResource ValidatingFieldBox}"
                     ToolTip="Таймаут массовой записи, сек (0 или пусто — 60 по умолчанию)">
                <TextBox.Text>
                    <Binding Path="Prop_BulkCopyTimeoutSeconds" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <local:NumericValidationRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <CheckBox Style="{StaticResource FieldCheckBox}" Content="Использовать блокировку таблицы (SQL Server, TableLock)"
                      IsChecked="{Binding Prop_UseTableLock}"
                      Margin="0,6,0,0"
                      ToolTip="SqlBulkCopyOptions.TableLock — блокировка таблицы на время загрузки (только SQL Server)"/>

            <CheckBox Style="{StaticResource FieldCheckBox}" Content="Сохранять identity (SQL Server, KeepIdentity)"
                      IsChecked="{Binding Prop_KeepIdentity}"
                      Margin="0,4,0,0"
                      ToolTip="SqlBulkCopyOptions.KeepIdentity — переносить значения identity из DataTable (только SQL Server)"/>

            <TextBlock Text="Очистка перед загрузкой:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{local:EnumValues local:DatabaseBulkPreloadMode}" SelectedValue="{Binding Prop_PreloadMode}" SelectedValuePath="Key" DisplayMemberPath="Display"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Без очистки / Удалить все строки (DELETE) / TRUNCATE перед загрузкой"/>
        </StackPanel>
    </Grid>
</UserControl>
