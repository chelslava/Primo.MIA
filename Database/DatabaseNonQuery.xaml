<UserControl x:Class="Primo.MIA.DatabaseNonQuery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="80"
             Margin="0,0,0,5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/bd.png"/>

        <StackPanel Grid.Column="1" Margin="5,0,5,5">
            <TextBlock Text="БД: Выполнить команду" Style="{StaticResource ActivityHeader}"/>

            <TextBlock Text="Поставщик (invariant name):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ProviderInvariantName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Поставщик ADO.NET (invariant name): System.Data.SqlClient (по умолчанию), Npgsql, MySql.Data.MySqlClient и т.п."/>

            <TextBlock Text="Строка подключения:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ConnectionString, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Строка подключения ADO.NET (формат зависит от провайдера)"/>

            <TextBlock Text="TransactionId (необязательно):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_TransactionId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Идентификатор транзакции из «БД: Начать транзакцию»; пусто — выполнить вне транзакции"/>

            <TextBlock Text="Тип команды:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{local:EnumValues local:DatabaseCommandType}" SelectedValue="{Binding Prop_CommandType}" SelectedValuePath="Key" DisplayMemberPath="Display"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="SQL-текст или хранимая процедура"/>

            <TextBlock Text="SQL / имя процедуры:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_CommandText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="SQL-запрос (INSERT/UPDATE/DELETE/…) или имя хранимой процедуры"/>

            <TextBlock Text="Параметры (Dictionary&lt;string,string&gt;):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_Parameters, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Именованные параметры команды: имя (@param) → значение"/>

            <TextBlock Text="Таймаут (сек):" Style="{StaticResource FieldLabel}"/>
            <TextBox Style="{StaticResource ValidatingFieldBox}"
                     ToolTip="Таймаут команды, сек (0 или пусто — 30 по умолчанию)">
                <TextBox.Text>
                    <Binding Path="Prop_CommandTimeoutSeconds" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <local:NumericValidationRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <CheckBox Foreground="#FF2C3E50" Content="Разбивать SQL-текст по GO batch"
                      IsChecked="{Binding Prop_SplitByGoBatches}"
                      Margin="0,6,0,0"
                      ToolTip="Разбивать SQL-текст на батчи по разделителю GO (как в SQL Server Management Studio)"/>

            <CheckBox Foreground="#FF2C3E50" Content="Получать id вставленной записи"
                      IsChecked="{Binding Prop_ReturnIdentity}"
                      Margin="0,4,0,0"
                      ToolTip="Вернуть id последней вставленной записи (SCOPE_IDENTITY / RETURNING)"/>

            <TextBlock Text="Переменная затронутых строк:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_AffectedRows, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Переменная (Int32) для количества затронутых строк"/>

            <TextBlock Text="Значение identity (identity value):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_IdentityValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="Переменная для identity вставленной записи (при включённом флаге выше)"/>
        </StackPanel>
    </Grid>
</UserControl>
