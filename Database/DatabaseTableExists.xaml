<UserControl x:Class="Primo.MIA.DatabaseTableExists"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="80"
             Margin="0,0,0,5">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="32" Height="32" Margin="5" VerticalAlignment="Center" Source="pack://application:,,,/Primo.MIA;component/images/bd.png"/>
        <StackPanel Grid.Column="1" Margin="5,0,5,5">
            <TextBlock Text="БД: Проверить таблицу" Style="{StaticResource ActivityHeader}"/>
            <TextBlock Text="Provider invariant name:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ProviderInvariantName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            <TextBlock Text="Строка подключения:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_ConnectionString, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            <TextBlock Text="Имя таблицы:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_TableName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            <TextBlock Text="Схема (опционально):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_SchemaName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
        </StackPanel>
    </Grid>
</UserControl>
