<!--
    EncryptString.xaml
    Визуальный интерфейс активности "Крипто: Шифрование строки (AES)".
-->
<UserControl x:Class="Primo.MIA.EncryptString"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="50"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <local:ActivityPanel IconSource="pack://application:,,,/Primo.MIA;component/images/sharp.png">

            <TextBlock Style="{StaticResource ActivityHeader}"
                       Text="Крипто: Шифрование строки (AES)"/>

            <TextBlock Text="Строка (входная):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_InputString, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Открытый текст для шифрования"/>

            <TextBlock Text="Пароль:" Style="{StaticResource FieldLabel}"/>
            <PasswordBox local:PasswordBoxHelper.BindPassword="True"
                         local:PasswordBoxHelper.BoundPassword="{Binding Prop_Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldPasswordBox}"
                         ToolTip="Пароль шифрования (AES-256 + PBKDF2)"/>
    </local:ActivityPanel>
</UserControl>
