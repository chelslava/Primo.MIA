<!--
    HashCalculate.xaml
    Визуальный интерфейс активности "Крипто: Хэширование".

    Функции:
      - Хэширование строки или файла
      - Выбор алгоритма и формата вывода
-->
<UserControl x:Class="Primo.MIA.HashCalculate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Primo.MIA"
             mc:Ignorable="d"
             d:DesignHeight="50"
             Margin="0,0,0,5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Primo.MIA;component/Common/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="HashSourceValues"
                                MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:CryptoHashSource"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="HashAlgorithmValues"
                                MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:CryptoHashAlgorithm"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="HashFormatValues"
                                MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:CryptoHashOutputFormat"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Width="32" Height="32" Margin="5"
               VerticalAlignment="Center"
               Source="pack://application:,,,/Primo.MIA;component/images/sharp.png"/>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Top"
                    Margin="5,0,5,5">

            <TextBlock Style="{StaticResource ActivityHeader}"
                       Text="Крипто: Хэширование"/>

            <TextBlock Text="Источник:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Source={StaticResource HashSourceValues}}"
                      SelectedItem="{Binding Prop_HashSource}"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Хэшировать строку или содержимое файла"/>

            <TextBlock Text="Строка (входная):" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_InputString, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Входная строка (режим Строка)"/>

            <TextBlock Text="Путь к файлу:" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Prop_FilePath, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}"
                     ToolTip="Путь к файлу (режим Файл)"/>

            <TextBlock Text="Алгоритм:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Source={StaticResource HashAlgorithmValues}}"
                      SelectedItem="{Binding Prop_HashAlgorithm}"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="MD5, SHA1, SHA256, SHA384, SHA512"/>

            <TextBlock Text="Формат вывода:" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Source={StaticResource HashFormatValues}}"
                      SelectedItem="{Binding Prop_HashFormat}"
                      Style="{StaticResource FieldComboBox}"
                      ToolTip="Hex (нижний/верхний регистр) или Base64"/>

        </StackPanel>
    </Grid>
</UserControl>
